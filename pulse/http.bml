// Native listener and reusable durable read templates; no framework or host server.
// preludes: form/form-stdlib/core.fk form/form-stdlib/json.fk ../pulse/store.bml
section [form.bml] {
 class PulseHttp {
  def ph-days(target) {
   let query = split-on(target,"?");
   let pairs = len(query) < 2 ? [] : split-on(query[1],"&");
   let found = filter(pair => str_find(pair,"days=",0) == 0,pairs);
   nil?(found) ? 90 : { let last = reverse(found)[0]; let text = trim(wr-decode(substring(last,5,len(last)),0,"")); let digits = str_find(text,"+",0) == 0 ? substring(text,1,len(text)) : text; let n = str_to_int(digits); wr-digits?(digits,0) && n >= 1 && n <= 180 ? n : 0; };
  }
  def ph-cors(cfg, raw) {
   let origin = wr-header(split-on(raw,"\r\n"),"origin");
   let origins = wr-array(cfg,"cors_origins");
   let wildcard = any?(one => json-string-value(one) == "*",origins);
   wildcard || any?(one => json-string-value(one) == origin,origins) ? "Access-Control-Allow-Origin: " ++ (wildcard ? "*" : origin) ++ "\r\nVary: Origin\r\nAccess-Control-Allow-Methods: GET, OPTIONS\r\nAccess-Control-Allow-Headers: *\r\n" : "";
  }
  def ph-handle(cfg, organs, raw) {
   let words = split-on(split-on(raw,"\r\n")[0]," ");
   let method = words[0];
   let target = len(words) < 2 ? "" : words[1];
   let path = split-on(target,"?")[0];
   let days = ph-days(target);
   let known = any?(one => one == path,["/","/pulse/health","/pulse/now","/pulse/history","/pulse/silences"]);
   let code = !known ? 404 : method != "GET" && method != "OPTIONS" ? 405 : (path == "/pulse/history" || path == "/pulse/silences") && days == 0 ? 422 : 200;
   let body = code != 200 ? (code == 422 ? "{\"detail\":\"days must be an integer from 1 to 180\"}" : "{\"detail\":\"Not Found or method not allowed\"}") : method == "OPTIONS" ? "{}" : path == "/" ? "{\"service\":\"pulse\",\"version\":\"1.1.0-form\",\"runtime\":\"fkwu\",\"endpoints\":[\"/pulse/now\",\"/pulse/history\",\"/pulse/silences\",\"/pulse/health\"]}" : fp-task(cfg,"../pulse/read.bml",wr-overlay(cfg,fp-object([["path",path],["days",days]])));
   wr-response(code,body,ph-cors(cfg,raw) ++ "X-Form-Router: fkwu\r\n");
  }
 }
 let cfg = wr-config();
 let organs = ws-organs();
 let listener = socket_listen(wr-number(cfg,"port"));
 listener < 0 ? form_error("pulse native listener could not open") : wr-serve(listener,raw => ph-handle(cfg,organs,raw));
}
