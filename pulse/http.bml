// Admitted native cells survive into each isolated request context. Socket and
// child completion events wake the owner; no request executable or file bridge.
// preludes: form/form-stdlib/core.fk form/form-stdlib/json.fk form/form-stdlib/bml/native-socket-dispatch.bml ../pulse/http-handler.bml
section [form.bml] {
 let cfg = wr-config();
 let read = cell_call("../pulse/read.bml",nothing(),"check");
 let view = cell_call("../pulse/read-view.bml",nothing(),"check");
 record_get(read,"errors")>0 || record_get(view,"errors")>0 ? form_error("native HTTP read admission failed") : {
  let organs = ws-organs();
  nsd-serve(nsd-open(wr-number(cfg,"port"),raw => ph-handle(wr-overlay(cfg,fp-object([["request_began_ms",host_monotonic_ms()]])),organs,raw)));
 };
}
