// Reusable native persistence: typed Recipe snapshots and framed transaction logs.
// No database process, SQL interpreter, shell or host-language codec participates.
import ../pulse/templates.bml;
import form-stdlib/sort.fk;
import form-stdlib/sha256.fk;
import form-stdlib/bml/host-walk-clock.bml;
import form-stdlib/bml/dir-lock.bml;
section [form.bml] {
 class FormPersistence {
  def fp-vector() = bp("FormPersistentSequence");
  def fp-null() = bp("FormPersistentNull");
  def fp-pack(v) = nothing?(v) ? intern_node(fp-null(),[]) : value_kind(v) == "list" ? intern_node(fp-vector(),map(x => fp-pack(x),v)) : value_kind(v) == "string" ? intern_trivial_string(v) : value_kind(v) == "float" ? make_float64(v) : intern_trivial_int(v);
  def fp-unpack(v) = node_eq(node_category(v),fp-vector()) ? map(x => fp-unpack(x),node_children(v)) : node_eq(node_category(v),fp-null()) ? nothing() : node_value(v);
  def fp-read(path, fallback) { let node = read_form_binary(path); nothing?(node) ? file_size(path) >= 0 ? form_error("native Recipe could not be read: " ++ path) : fallback : fp-unpack(node); }
  def fp-required(path) = file_size(path)<0 ? form_error("native history page is missing: " ++ path) : fp-read(path,nothing());
  def fp-write(path,v) = fp-write-batch([[path,v]])[0];
  def fp-write-batch(pages) {
   let staged = map(page => {
    let stage = page[0] ++ ".pending-" ++ host_pid().str();
    let n = write_form_binary(stage,fp-pack(page[1]));
    n < 0 ? form_error("native Recipe staging failed: " ++ page[0]) : [stage,page[0],n];
   },pages);
   // Independent pages share one barrier. Every canonical replacement still
   // names synchronized bytes; dependent publications call a following batch.
   let stable = nil?(staged) ? 0 : host_sync();
   map(page => host_path_rename(page[0],page[1]) != 0 ? form_error("native Recipe publication failed: " ++ page[1]) : page[2],staged);
  }
  def fp-get(pairs, key, fallback) { let found = filter(p => p[0] == key,pairs); nil?(found) ? fallback : found[0][1]; }
  def fp-set(pairs, key, value) = append(filter(p => p[0] != key,pairs),[[key,value]]);
  // Compute a structural key once, rather than at every merge comparison.
  def fp-order(xs,key,before) = map(pair => pair[1],sort-with((a,b) => before(a[0],b[0]),nothing(),map(x => [key(x),x],xs)));
  def fp-histogram(pairs) = fp-histogram-chunks([pairs]);
  def fp-histogram-chunks(chunks) {
   let bins = record_new(0);
   let counted = foldl((total,chunk) => foldl((n,pair) => {
    let key = value_str(pair[0]);
    let old = record_has(bins,key) ? record_get(bins,key)[1] : 0;
    record_set(bins,key,[pair[0],old+pair[1]]);
   },0,chunk),0,chunks);
   sort-by(map(key => record_get(bins,key),record_keys(bins)),pair => pair[0]);
  }
  def fp-ordered-rank(hist,rank,n) = nil?(hist) ? nothing() : n+hist[0][1]>=rank ? hist[0][0] : fp-ordered-rank(hist[1:],rank,n+hist[0][1]);
  def fp-weighted-percentiles(chunks,percentages) {
   fp-ordered-percentiles(fp-histogram-chunks(chunks),percentages);
  }
  def fp-ordered-percentiles(hist,percentages) {
   let n = foldl((count,pair) => count+pair[1],0,hist);
   map(p => n == 0 ? nothing() : fp-ordered-rank(hist,(n*p+99)/100,0),percentages);
  }
  // Reusable aligned range partition. Height controls physical fan-in, never
  // the number of days retained or readable: a longer range uses more blocks.
  def fp-block-size(level) = level == 0 ? 1 : 2*fp-block-size(level - 1);
  def fp-cover-level(day,remaining,level,height) = level<height && day%fp-block-size(level+1) == 0 && fp-block-size(level+1)<=remaining ? fp-cover-level(day,remaining,level+1,height) : level;
  def fp-range-cover(first,last,height) = first>last ? [] : {
   let level = fp-cover-level(first,last - first+1,0,height); let size = fp-block-size(level);
   cons([level,first/size],fp-range-cover(first+size,last,height));
  };
  def fp-json(v) = nothing?(v) ? json-node-null() : value_kind(v) == "node_id" ? v : value_kind(v) == "list" ? json-node-array(map(x => fp-json(x),v)) : value_kind(v) == "string" ? json-node-string(v) : value_kind(v) == "float" ? json-node-float-text(v.str()) : json-node-int(v);
  def fp-object(pairs) = json-node-object(map(p => json-node-pair(p[0],fp-json(p[1])),pairs));
  // Sibling runs are spans, not recursively copied growing JSON suffixes.
  // Canonical Form JSON owns scalar escaping and numeric rendering.
  def fp-comma(parts) = str-spans(reverse(foldl((out,part) => nil?(out) ? [part] : cons(part,cons(",",out)),[],parts)));
  def fp-emit(node) {
   let cat = node_category(node);
   node_eq(cat,JSON-OBJECT()) ? "{" ++ fp-comma(map(child => fp-emit(child),node_children(node))) ++ "}"
   : node_eq(cat,JSON-ARRAY()) ? "[" ++ fp-comma(map(child => fp-emit(child),node_children(node))) ++ "]"
   : node_eq(cat,JSON-PAIR()) ? json-quote-string(json-pair-key(node)) ++ ":" ++ fp-emit(json-pair-value(node))
   : node_eq(cat,JSON-NULL()) ? "null" : json-emit-leaf(node);
  }
  def fp-pad(n, width) { let s = n.str(); len(s) >= width ? s : fp-pad-text(s,width); }
  def fp-pad-text(s, width) = len(s) >= width ? s : fp-pad-text("0" ++ s,width);
  def fp-day(ms) = hw-day-text(hw-civil(ms / 86400000));
  def fp-stamp(ms) = fp-day(ms) ++ "T" ++ hw-pad2((ms / 3600000) % 24) ++ ":" ++ hw-pad2((ms / 60000) % 60) ++ ":" ++ hw-pad2((ms / 1000) % 60) ++ "Z";
  def fp-days(y,m,d) { let yy = m <= 2 ? y - 1 : y; let era = yy/400; let yo = yy - era*400; let doy = (153*(m>2 ? m - 3 : m+9)+2)/5+d - 1; era*146097+yo*365+yo/4-yo/100+doy - 719468; }
  def fp-time(s) = (fp-days(str_to_int(substring(s,0,4)),str_to_int(substring(s,5,7)),str_to_int(substring(s,8,10)))*86400+str_to_int(substring(s,11,13))*3600+str_to_int(substring(s,14,16))*60+str_to_int(substring(s,17,19)))*1000;
  def fp-bytes(s, i, out) = i < 0 ? out : fp-bytes(s,i - 1,cons(str_byte_at(s,i),out));
  def fp-hex(bytes) = hch-join(map(n => substring("0123456789abcdef",n/16,n/16+1) ++ substring("0123456789abcdef",n%16,n%16+1),bytes),"");
  // Native Form binary is self-describing. Length + SHA-256 admit complete
  // frames; a torn tail is never promoted into a committed transaction.
  def fp-frame(path, value) {
   let body = recipe_to_bytes(fp-pack(value));
   let bytes = str-spans(map(n => byte_to_str(n),body));
   let head = fp-pad(len(bytes),12) ++ " " ++ fp-hex(sha256(body)) ++ "\n";
   let at = file_size(path) < 0 ? 0 : file_size(path);
   let n = host_pwrite(path,at,head ++ bytes);
   n != len(head)+len(bytes) ? form_error("native transaction append failed: " ++ path) : at+n;
  }
  def fp-replay(path, at, receive) {
   let size = file_size(path);
   at+78 > size ? at : {
    let head = read_file_slice(path,at,78);
    let n = str_to_int(substring(head,0,12));
    let body = n > 0 && at+78+n <= size ? read_file_slice(path,at+78,n) : "";
    n <= 0 || len(body) != n || fp-hex(sha256(fp-bytes(body,len(body) - 1,[]))) != substring(head,13,77) ? at : {
     let node = bytes_to_recipe(fp-bytes(body,len(body)-1,[]));
     nothing?(node) ? form_error("native transaction frame did not decode") : { let got = receive(fp-unpack(node),at+78+n); fp-replay(path,at+78+n,receive); };
    };
   };
  }
  def fp-lock(root) {
   let owned = fp-take(root ++ "/lock",0);
   owned != 1 ? form_error("native persistence owner could not be recorded: " ++ root) : owned;
  }
  // Reuse native owner/claim care, without expiring a living transaction.
  def fp-take(path,tries) = host_dir_mkdir(path) == 1 ? dl-own(path) : host_path_is_dir(path) != 1 ? form_error("native persistence lock is not writable: " ++ path) : {
   let text = dl-owner(path);
   let pid = dl-field(text,"pid="); let at = dl-field(text," at=");
   let stale = nothing?(pid) ? dl-age-ms(path)>2000 : !dl-holds?(pid,at);
   let mark = path ++ "/took-" ++ (nothing?(pid) ? "unowned" : pid.str());
   let claimed = stale ? host_dir_mkdir(mark) : 0;
   stale && claimed == 1 && dl-owner(path) == text ? dl-own(path) : {
    let clear = stale && dl-age-ms(mark)>10000 ? host_dir_rmdir(mark) : 0;
    let rested = host_sleep_ms(dl-backoff(tries));
    fp-take(path,tries+1);
   };
  };
  def fp-unlock(root) = dl-release(root ++ "/lock");
  // Native task scopes release private temporary nodes after a durable effect
  // or read. No shell, interpreter or external database participates.
  def fp-task(cfg,entry,request) {
   let io = wr-io(cfg,"task"); let made = hch-mkdirs(io);
   let rotated = hch-rotate(io,"request");
   let fed = write_file_text(io ++ "/request.in",json-emit(request));
   let pid = host_spawn_at(["./fkwu",entry],[io ++ "/request.in",io ++ "/request.out",io ++ "/request.err"]);
   let status = pid < 0 ? 127 : host_wait(pid);
   let recorded = write_file_text(io ++ "/request.exit",status.str());
   status != 0 ? form_error("native persistence task failed: " ++ entry ++ "; exact input/stdout/stderr/exit at " ++ io) : trim(read_file(io ++ "/request.out") ?? "");
  }
 }
}
