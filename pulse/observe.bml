// Focused application observation, with explicit local config on stdin.
// preludes: form/form-stdlib/core.fk form/form-stdlib/json.fk form/form-stdlib/bml/stdin-source.bml ../pulse/probe.bml
section [form.bml] {
 class PulseObservation {
  def po-inventory(cfg) = nw-locked(cfg,meta => {
   let days = fp-get(meta,"days",[]);
   let raw = foldl((counts,day) => {
    let index = fp-required(nw-path(cfg,"raw/" ++ day ++ "/index.fkb"))[1];
    [counts[0]+foldl((n,p) => n+p[3],0,index),counts[1]+len(index)];
   },[0,0],days);
   let silence = foldl((counts,bucket) => {
    let rows = fp-required(nw-path(cfg,"silences/" ++ fp-pad(bucket[0],8) ++ ".fkb"))[1];
    [counts[0]+len(rows),counts[1]+len(filter(row => !nothing?(row[5]),rows))];
   },[0,0],fp-get(meta,"buckets",[]));
   raw[0] != fp-get(meta,"samples_total",0) ? form_error("native indexed history differs from its durable sample count") : json-emit(fp-object([["samples",raw[0]],["raw_pages",raw[1]],["max_rowid",fp-get(meta,"max_rowid",0)],["days",len(days)],["first_day",nil?(days) ? nothing() : days[0]],["last_day",nil?(days) ? nothing() : reverse(days)[0]],["silences",silence[0]],["last_silence_id",fp-get(meta,"max_silence",0)],["repair_notes",silence[1]],["import_receipt",fp-object(fp-read(nw-path(cfg,"import-receipt.fkb"),[]))]]));
  });
  def po-boundary(cfg) {
   let base = wr-text(cfg,"base");
   let requests = json-object-has?(cfg,"requests") ? map(row => map(v => node_value(v),node_children(row)),wr-array(cfg,"requests")) : [["health","/pulse/health"],["now","/pulse/now"],["history","/pulse/history?days=7"],["silences","/pulse/silences?days=7"]];
   let rows = map(request => {
    let began = host_monotonic_ms();
    let response = wr-fetch("GET",base ++ request[1],"",0);
    let elapsed = host_monotonic_ms()-began;
    let doc = parse-json("pulse-boundary",len(response[1]) == 0 ? "{}" : response[1]);
    let organs = wr-array(doc,"organs");
    json-node-object([json-node-pair("surface",json-node-string(request[0])),json-node-pair("status",json-node-int(response[0])),json-node-pair("latency_ms",json-node-int(elapsed)),json-node-pair("bytes",json-node-int(len(response[1]))),json-node-pair("organs",json-node-int(len(organs))),json-node-pair("daily_bars",json-node-int(nil?(organs) ? 0 : len(wr-array(organs[0],"daily")))),json-node-pair("samples_total",json-object-get(doc,"samples_total")),json-node-pair("silences",json-node-int(len(wr-array(doc,"silences")))),json-node-pair("overall",json-object-get(doc,"overall"))]);
   },requests);
   json-emit(json-node-object([json-node-pair("native",json-node-string("fkwu")),json-node-pair("observations",json-node-array(rows))]));
  }
  def po-fixture(cfg, organs) {
   let started = ws-start(cfg);
   let now = now_unix_ms();
   let fail = ws-record(cfg,map(i => [fp-stamp(now - (8-i)*1000),"api",0,100,"fixture transport failure"],range(0,3)),organs);
   let opened = len(fp-get(nw-meta(cfg),"open",[]));
   let restored = ws-record(cfg,map(i => [fp-stamp(now - (3-i)*1000),"api",1,(i+1)*10,nothing()],range(0,3)),organs);
   let history = ws-history(cfg,nw-meta(cfg),organs,7);
   let silences = ws-silences(cfg,nw-meta(cfg),organs,7);
   let first = wr-array(history,"organs")[0];
   let receipt = wr-array(silences,"silences")[0];
   let windows = all?(days => len(wr-array(wr-array(ws-history(cfg,nw-meta(cfg),organs,days),"organs")[0],"daily")) == days,[1,30,90,180]);
   let before = nw-meta(cfg);
   let complete = nw-commit(cfg,before,[[7,fp-stamp(now),"api",1,40,nothing()]],[]);
   // A durable journal and pages whose checkpoint did not survive.
   let checkpoint = fp-write(nw-path(cfg,"state.fkb"),before);
   let log = nw-log(cfg,fp-get(complete,"journal",0));
   let torn = host_pwrite(log,file_size(log),"000000000100 partial");
   let recovered = nw-recover(cfg); let again = nw-recover(cfg);
   let raw = nw-raw-day(cfg,fp-day(now),0);
   let recovery = fp-get(recovered,"samples_total",0) == 7 && fp-get(again,"samples_total",0) == 7 && len(raw) == 7 && nw-stat(cfg,fp-day(now),"api")[1] == 7;
   let ok = opened == 1 && len(fp-get(nw-meta(cfg),"open",[])) == 0 && str_find(wr-text(receipt,"note"),"closed after 3 consecutive",0)>=0 && wr-number(first,"latency_p50_ms") == 20 && wr-number(first,"latency_p95_ms") == 30 && windows && recovery;
   ok ? "{\"fixture\":\"observed\",\"persistence\":\"form-recipes\",\"nearest_rank\":[20,30],\"silence\":\"durable repair receipt\",\"recovery\":\"idempotent; torn tail retained\",\"windows\":[1,7,30,90,180]}" : form_error("native persistence fixture did not match its contract");
  }
 }
 let cfg = wr-overlay(wr-config(),parse-json("pulse-observation",stdin-text()));
 let organs = ws-organs();
 wr-text(cfg,"mode") == "boundary" ? po-boundary(cfg) : wr-text(cfg,"mode") == "fixture" ? po-fixture(cfg,organs) : wr-text(cfg,"mode") == "inventory" ? po-inventory(cfg) : nw-locked(cfg,meta => json-emit(ws-now(cfg,meta,organs)));
}
