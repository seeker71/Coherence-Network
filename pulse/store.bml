// Durable witness template. Existing samples, silence IDs and repair receipts stay authoritative.
import ../pulse/templates.bml;
section [form.bml] {
 class WitnessStore {
  def ws-organs() = node_children(parse-json("pulse-organs", read_file("../pulse/organs.json")));
  def ws-catalog(organs) = "catalog AS (SELECT CAST(key AS INTEGER) ordinal,json_extract(value,'$.name') name,json_extract(value,'$.label') label,json_extract(value,'$.description') description FROM json_each(" ++ wr-quote(json-emit(json-node-array(organs))) ++ "))";
  def ws-schema() = "PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL; CREATE TABLE IF NOT EXISTS samples(ts TEXT NOT NULL,organ TEXT NOT NULL,ok INTEGER NOT NULL,latency_ms INTEGER,detail TEXT); CREATE INDEX IF NOT EXISTS idx_samples_organ_ts ON samples(organ,ts); CREATE INDEX IF NOT EXISTS idx_samples_ts ON samples(ts); CREATE TABLE IF NOT EXISTS silences(id INTEGER PRIMARY KEY AUTOINCREMENT,organ TEXT NOT NULL,started_at TEXT NOT NULL,ended_at TEXT,severity TEXT NOT NULL,note TEXT); CREATE INDEX IF NOT EXISTS idx_silences_started ON silences(started_at); CREATE INDEX IF NOT EXISTS idx_silences_organ ON silences(organ,started_at); CREATE TABLE IF NOT EXISTS witness_meta(key TEXT PRIMARY KEY,value TEXT NOT NULL); INSERT OR IGNORE INTO witness_meta SELECT 'samples_total',COUNT(*) FROM samples; CREATE TRIGGER IF NOT EXISTS witness_sample_added AFTER INSERT ON samples BEGIN UPDATE witness_meta SET value=CAST(value AS INTEGER)+1 WHERE key='samples_total'; END; CREATE TRIGGER IF NOT EXISTS witness_sample_retired AFTER DELETE ON samples BEGIN UPDATE witness_meta SET value=CAST(value AS INTEGER)-1 WHERE key='samples_total'; END;";
  def ws-summary-schema() = hch-join([
   "BEGIN IMMEDIATE; CREATE TABLE IF NOT EXISTS witness_days(organ TEXT,day TEXT,samples INTEGER NOT NULL,failures INTEGER NOT NULL,PRIMARY KEY(organ,day)) WITHOUT ROWID; CREATE TABLE IF NOT EXISTS witness_latencies(organ TEXT,day TEXT,latency_ms INTEGER,n INTEGER NOT NULL,PRIMARY KEY(organ,day,latency_ms)) WITHOUT ROWID;",
   "INSERT INTO witness_days SELECT organ,substr(ts,1,10),count(*),sum(NOT ok) FROM samples WHERE COALESCE(detail,'') NOT LIKE 'unobserved: %' AND NOT EXISTS(SELECT 1 FROM witness_meta WHERE key='summaries_ready') GROUP BY organ,substr(ts,1,10);",
   "INSERT INTO witness_latencies SELECT organ,substr(ts,1,10),latency_ms,count(*) FROM samples WHERE ok AND latency_ms IS NOT NULL AND COALESCE(detail,'') NOT LIKE 'unobserved: %' AND NOT EXISTS(SELECT 1 FROM witness_meta WHERE key='summaries_ready') GROUP BY organ,substr(ts,1,10),latency_ms;",
   "INSERT OR IGNORE INTO witness_meta VALUES('summaries_ready','1');",
   "CREATE TRIGGER IF NOT EXISTS witness_day_added AFTER INSERT ON samples WHEN COALESCE(new.detail,'') NOT LIKE 'unobserved: %' BEGIN INSERT INTO witness_days VALUES(new.organ,substr(new.ts,1,10),1,NOT new.ok) ON CONFLICT(organ,day) DO UPDATE SET samples=samples+1,failures=failures+(NOT new.ok); END;",
   "CREATE TRIGGER IF NOT EXISTS witness_latency_added AFTER INSERT ON samples WHEN new.ok AND new.latency_ms IS NOT NULL AND COALESCE(new.detail,'') NOT LIKE 'unobserved: %' BEGIN INSERT INTO witness_latencies VALUES(new.organ,substr(new.ts,1,10),new.latency_ms,1) ON CONFLICT(organ,day,latency_ms) DO UPDATE SET n=n+1; END;",
   "CREATE TRIGGER IF NOT EXISTS witness_day_retired AFTER DELETE ON samples WHEN COALESCE(old.detail,'') NOT LIKE 'unobserved: %' BEGIN UPDATE witness_days SET samples=samples-1,failures=failures-(NOT old.ok) WHERE organ=old.organ AND day=substr(old.ts,1,10); DELETE FROM witness_days WHERE organ=old.organ AND day=substr(old.ts,1,10) AND samples=0; END;",
   "CREATE TRIGGER IF NOT EXISTS witness_latency_retired AFTER DELETE ON samples WHEN old.ok AND old.latency_ms IS NOT NULL AND COALESCE(old.detail,'') NOT LIKE 'unobserved: %' BEGIN UPDATE witness_latencies SET n=n-1 WHERE organ=old.organ AND day=substr(old.ts,1,10) AND latency_ms=old.latency_ms; DELETE FROM witness_latencies WHERE organ=old.organ AND day=substr(old.ts,1,10) AND latency_ms=old.latency_ms AND n=0; END; COMMIT;"
  ], "\n");
  def ws-start(cfg) = wr-sql(cfg, "start", ws-schema() ++ ws-summary-schema() ++ "INSERT OR REPLACE INTO witness_meta VALUES('started_at',strftime('%Y-%m-%dT%H:%M:%SZ','now')); INSERT OR IGNORE INTO witness_meta VALUES('last_retention',strftime('%s','now')); ");
  def ws-insert(organ, stamp, ok, latency, detail) = "INSERT INTO samples VALUES(strftime('%Y-%m-%dT%H:%M:%SZ'," ++ (stamp / 1000).str() ++ ",'unixepoch')," ++ wr-quote(wr-text(organ,"name")) ++ "," ++ (ok ? "1" : "0") ++ "," ++ latency.str() ++ "," ++ (len(detail) == 0 ? "NULL" : wr-quote(detail)) ++ ");";
  def ws-sample(cfg, organ, stamp, ok, latency, detail) = wr-sql(cfg, "sample-" ++ wr-text(organ, "name"), "INSERT INTO samples VALUES(strftime('%Y-%m-%dT%H:%M:%SZ'," ++ (stamp / 1000).str() ++ ",'unixepoch')," ++ wr-quote(wr-text(organ, "name")) ++ "," ++ (ok ? "1" : "0") ++ "," ++ latency.str() ++ "," ++ (len(detail) == 0 ? "NULL" : wr-quote(detail)) ++ ");");
  def ws-tail(organs) = hch-join(map(organ => "SELECT * FROM (SELECT rowid,ts,organ,ok,detail FROM samples WHERE organ=" ++ wr-quote(wr-text(organ, "name")) ++ " ORDER BY ts DESC,rowid DESC LIMIT 20)", organs), " UNION ALL ");
  def ws-reconcile(organs) = "BEGIN IMMEDIATE; CREATE TEMP TABLE witness_tail AS WITH raw AS (" ++ ws-tail(organs) ++ "), observed AS (SELECT *,row_number() OVER(PARTITION BY organ ORDER BY ts DESC,rowid DESC) rn FROM raw WHERE COALESCE(detail,'') NOT LIKE 'unobserved: %'), recent AS (SELECT *,first_value(ok) OVER(PARTITION BY organ ORDER BY rn) last_ok FROM observed WHERE rn<=5), runs AS (SELECT *,sum(ok<>last_ok) OVER(PARTITION BY organ ORDER BY rn) breaks FROM recent) SELECT organ,last_ok ok,count(*) n,min(ts) first_ts,max(ts) last_ts FROM runs WHERE breaks=0 GROUP BY organ; CREATE TEMP TABLE witness_open AS SELECT * FROM silences WHERE id IN (SELECT (SELECT id FROM silences s WHERE s.organ=t.organ AND ended_at IS NULL ORDER BY started_at DESC,id DESC LIMIT 1) FROM witness_tail t); UPDATE silences SET ended_at=(SELECT first_ts FROM witness_tail WHERE organ=silences.organ),note=(SELECT 'boundary_repair_protocol: choice=re_enter; closed after '||n||' consecutive breathing samples; evidence_window='||first_ts||'..'||last_ts FROM witness_tail WHERE organ=silences.organ) WHERE id IN(SELECT id FROM witness_open) AND organ IN(SELECT organ FROM witness_tail WHERE ok=1 AND n>=3); UPDATE silences SET severity='silent' WHERE id IN(SELECT id FROM witness_open) AND ended_at IS NULL AND unixepoch('now')-unixepoch(started_at)>=300; INSERT INTO silences(organ,started_at,severity) SELECT organ,first_ts,'strained' FROM witness_tail t WHERE ok=0 AND n>=3 AND NOT EXISTS(SELECT 1 FROM silences s WHERE s.organ=t.organ AND ended_at IS NULL); DROP TABLE witness_tail; DROP TABLE witness_open; COMMIT;";
  def ws-care(cfg, organs) = wr-sql(cfg, "reconcile", ws-reconcile(organs));
  def ws-retain(cfg) = wr-sql(cfg, "retention", "BEGIN IMMEDIATE; DELETE FROM samples WHERE ts<strftime('%Y-%m-%dT%H:%M:%SZ','now','-" ++ wr-number(cfg,"retention_days").str() ++ " days') AND unixepoch('now')-CAST((SELECT value FROM witness_meta WHERE key='last_retention') AS INTEGER)>=86400; UPDATE witness_meta SET value=unixepoch('now') WHERE key='last_retention' AND unixepoch('now')-CAST(value AS INTEGER)>=86400; COMMIT;");
  def ws-health() = "SELECT json_object('status','ok','version','1.0.0-form','runtime','fkwu','started_at',(SELECT value FROM witness_meta WHERE key='started_at'),'uptime_seconds',max(0,unixepoch('now')-unixepoch((SELECT value FROM witness_meta WHERE key='started_at'))),'samples_total',CAST((SELECT value FROM witness_meta WHERE key='samples_total') AS INTEGER));";
  def ws-now(cfg, organs) = "WITH " ++ ws-catalog(organs) ++ ", latest AS (SELECT c.*,(SELECT rowid FROM samples s WHERE s.organ=c.name ORDER BY ts DESC,rowid DESC LIMIT 1) sample_id FROM catalog c), current AS (SELECT c.*,s.ts,s.latency_ms,s.detail,CASE WHEN s.ts IS NULL OR unixepoch('now')-unixepoch(s.ts)>" ++ (3 * wr-number(cfg,"interval_seconds")).str() ++ " OR COALESCE(s.detail,'') LIKE 'unobserved: %' THEN 'unknown' WHEN NOT s.ok THEN 'silent' WHEN s.detail LIKE 'slow: %' OR s.detail LIKE 'fell back: %' THEN 'strained' ELSE 'breathing' END status FROM latest c LEFT JOIN samples s ON s.rowid=c.sample_id), open AS (SELECT * FROM silences WHERE ended_at IS NULL ORDER BY started_at) SELECT json_object('overall',CASE WHEN EXISTS(SELECT 1 FROM current WHERE status='silent') OR EXISTS(SELECT 1 FROM open WHERE severity='silent') THEN 'silent' WHEN EXISTS(SELECT 1 FROM open) OR EXISTS(SELECT 1 FROM current WHERE status='strained') THEN 'strained' WHEN NOT EXISTS(SELECT 1 FROM current WHERE status<>'unknown') THEN 'unknown' ELSE 'breathing' END,'checked_at',strftime('%Y-%m-%dT%H:%M:%SZ','now'),'witness_started_at',(SELECT value FROM witness_meta WHERE key='started_at'),'organs',json((SELECT json_group_array(json_object('name',name,'label',label,'description',description,'status',status,'latency_ms',latency_ms,'last_sample_at',ts,'detail',CASE WHEN status IN('strained','silent') THEN detail END)) FROM (SELECT * FROM current ORDER BY ordinal))),'ongoing_silences',json((SELECT json_group_array(json_object('id',id,'organ',organ,'started_at',started_at,'severity',severity,'duration_seconds',max(0,unixepoch('now')-unixepoch(started_at)))) FROM open)));";
  def ws-silences(organs, days) = "WITH " ++ ws-catalog(organs) ++ " SELECT json_object('days'," ++ days.str() ++ ",'generated_at',strftime('%Y-%m-%dT%H:%M:%SZ','now'),'silences',json((SELECT json_group_array(json_object('id',id,'organ',organ,'organ_label',COALESCE((SELECT label FROM catalog WHERE name=organ),organ),'started_at',started_at,'ended_at',ended_at,'duration_seconds',max(0,unixepoch(COALESCE(ended_at,strftime('%Y-%m-%dT%H:%M:%SZ','now')))-unixepoch(started_at)),'severity',severity,'note',note)) FROM (SELECT * FROM silences WHERE started_at>=strftime('%Y-%m-%dT%H:%M:%SZ','now','-" ++ days.str() ++ " days') OR ended_at IS NULL ORDER BY started_at DESC))));";
  // Histogram counts retain exact nearest-rank percentiles without sorting or
  // transporting every successful sample through the application process.
  def ws-history(organs, days) = hch-join([
   "WITH RECURSIVE " ++ ws-catalog(organs) ++ ",",
   "calendar(day) AS (SELECT date('now','-" ++ (days - 1).str() ++ " days') UNION ALL SELECT date(day,'+1 day') FROM calendar WHERE day<date('now')) ,",
   "boundary AS MATERIALIZED (SELECT s.organ,substr(s.ts,1,10) day,s.ok,s.latency_ms FROM samples s JOIN catalog c ON c.name=s.organ WHERE s.ts>=strftime('%Y-%m-%dT%H:%M:%SZ','now','-" ++ days.str() ++ " days') AND s.ts<strftime('%Y-%m-%dT00:00:00Z','now','-" ++ (days - 1).str() ++ " days') AND COALESCE(s.detail,'') NOT LIKE 'unobserved: %'),",
   "counts AS (SELECT d.organ,d.day,d.samples n,d.failures FROM witness_days d JOIN catalog c ON c.name=d.organ WHERE d.day>date('now','-" ++ days.str() ++ " days') UNION ALL SELECT organ,day,count(*) n,sum(NOT ok) failures FROM boundary GROUP BY organ,day), totals AS (SELECT organ,sum(n) n,round(100.0*(sum(n)-sum(failures))/sum(n),2) uptime FROM counts GROUP BY organ),",
   "hist AS MATERIALIZED (SELECT h.organ,h.day,h.latency_ms,h.n FROM witness_latencies h JOIN catalog c ON c.name=h.organ WHERE h.day>date('now','-" ++ days.str() ++ " days') UNION ALL SELECT organ,day,latency_ms,count(*) n FROM boundary WHERE ok AND latency_ms IS NOT NULL GROUP BY organ,day,latency_ms),",
   "day_rank AS (SELECT *,sum(n) OVER(PARTITION BY organ,day ORDER BY latency_ms) cumulative,sum(n) OVER(PARTITION BY organ,day) total FROM hist),",
   "day_pct AS (SELECT organ,day,min(CASE WHEN cumulative>=(total*50+99)/100 THEN latency_ms END) p50,min(CASE WHEN cumulative>=(total*95+99)/100 THEN latency_ms END) p95 FROM day_rank GROUP BY organ,day),",
   "window_hist AS (SELECT organ,latency_ms,sum(n) n FROM hist GROUP BY organ,latency_ms), window_rank AS (SELECT *,sum(n) OVER(PARTITION BY organ ORDER BY latency_ms) cumulative,sum(n) OVER(PARTITION BY organ) total FROM window_hist),",
   "window_pct AS (SELECT organ,min(CASE WHEN cumulative>=(total*50+99)/100 THEN latency_ms END) p50,min(CASE WHEN cumulative>=(total*95+99)/100 THEN latency_ms END) p95 FROM window_rank GROUP BY organ),",
   "daily AS (SELECT c.name,calendar.day day,COALESCE(n,0) n,COALESCE(failures,0) failures,p50,p95 FROM catalog c CROSS JOIN calendar LEFT JOIN counts x ON x.organ=c.name AND x.day=calendar.day LEFT JOIN day_pct p ON p.organ=c.name AND p.day=calendar.day),",
   "bars AS (SELECT name,json_group_array(json_object('date',day,'status',CASE WHEN n=0 THEN 'unknown' WHEN failures*2>n THEN 'silent' WHEN 100.0*(n-failures)/n>=99.5 THEN 'breathing' ELSE 'strained' END,'samples',n,'failures',failures,'latency_p50_ms',p50,'latency_p95_ms',p95)) daily FROM (SELECT * FROM daily ORDER BY name,day) GROUP BY name),",
   "histories AS (SELECT c.*,COALESCE(t.uptime,0.0) uptime,t.n,p.p50,p.p95,b.daily FROM catalog c LEFT JOIN totals t ON t.organ=c.name LEFT JOIN window_pct p ON p.organ=c.name LEFT JOIN bars b ON b.name=c.name ORDER BY c.ordinal)",
   "SELECT json_object('days'," ++ days.str() ++ ",'generated_at',strftime('%Y-%m-%dT%H:%M:%SZ','now'),'overall',json_object('uptime_pct',COALESCE((SELECT round(avg(uptime),2) FROM histories WHERE n>0),0.0),'worst_uptime_pct',COALESCE((SELECT min(uptime) FROM histories WHERE n>0),0.0),'worst_organ',(SELECT name FROM histories WHERE n>0 AND uptime<100 ORDER BY uptime,ordinal LIMIT 1)),'organs',json((SELECT json_group_array(json_object('name',name,'label',label,'description',description,'uptime_pct',uptime,'latency_p50_ms',p50,'latency_p95_ms',p95,'daily',json(daily))) FROM histories)));"
  ], "\n");
 }
}
