// Pulse specializes the native persistence, repair and weighted-history templates.
import ../pulse/native-store.bml;
import ../pulse/import-history.bml;
section [form.bml] {
 class WitnessStore {
  def ws-organs() = node_children(parse-json("pulse-organs",read_file("../pulse/organs.json")));
  def ws-empty(cfg) = nw-create(cfg);
  def ws-start(cfg) {
   let meta = whi-start(cfg);
   let indexed = nw-index-ensure(cfg,ws-organs());
   let fresh = fp-set(indexed,"started_at",now_unix_ms());
   let saved = fp-write(nw-path(cfg,"state.fkb"),fresh);
   fresh;
  }
  def ws-run(rows, ok, out) = nil?(rows) ? reverse(out) : rows[0][3] != ok ? reverse(out) : ws-run(rows[1:],ok,cons(rows[0],out));
  def ws-changes(meta, organs) {
   let box = record_new(0,"id",fp-get(meta,"max_silence",0));
   foldl((changes,organ) => {
    let name = wr-text(organ,"name");
    let recent = filter(row => nw-observed(row),fp-get(fp-get(meta,"tails",[]),name,[]));
    let five = drop(len(recent)>5 ? len(recent) - 5 : 0,recent);
    let found = filter(row => row[1] == name,fp-get(meta,"open",[]));
    nil?(five) ? changes : {
     let last = reverse(five)[0];
     let run = reverse(ws-run(reverse(five),last[3],[]));
     let first = run[0];
     let open = nil?(found) ? nothing() : reverse(sort-by(found,row => fp-time(row[2])))[0];
     nothing?(open) ? last[3] == 0 && len(run)>=3 ? {
      let next = record_get(box,"id")+1;
      let held = record_set(box,"id",next);
      cons([next,name,first[1],nothing(),"strained",nothing()],changes);
     } : changes : last[3] != 0 && len(run)>=3 ? cons([open[0],name,open[2],first[1],open[4],"boundary_repair_protocol: choice=re_enter; closed after " ++ len(run).str() ++ " consecutive breathing samples; evidence_window=" ++ first[1] ++ ".." ++ last[1]],changes)
     : now_unix_ms() - fp-time(open[2]) >= 300000 && open[4] != "silent" ? cons([open[0],name,open[2],nothing(),"silent",open[5]],changes) : changes;
    };
   },[],organs);
  }
  def ws-care(cfg,meta,organs) {
   let changes = ws-changes(meta,organs);
   nil?(changes) ? meta : nw-commit(cfg,meta,[],changes);
  }
  def ws-record(cfg, samples, organs) = nw-locked(cfg,meta => {
   let first = fp-get(meta,"max_rowid",0)+1;
   let rows = map(i => cons(first+i,samples[i]),range(0,len(samples)));
   let tails = fp-set(meta,"tails",nw-tails(meta,rows));
   nw-commit(cfg,meta,rows,ws-changes(tails,organs));
  });
  def ws-health(meta) = fp-object([["status","ok"],["version","1.1.0-form"],["runtime","fkwu"],["persistence","form-recipes"],["started_at",fp-stamp(fp-get(meta,"started_at",0))],["uptime_seconds",(now_unix_ms() - fp-get(meta,"started_at",0))/1000],["samples_total",fp-get(meta,"samples_total",0)]]);
  def ws-status(cfg,last) = nothing?(last) ? "unknown" : !nw-observed(last) || now_unix_ms() - fp-time(last[1]) > wr-number(cfg,"interval_seconds")*3000 ? "unknown" : last[3] == 0 ? "silent" : !nothing?(last[5]) && (str_find(last[5],"slow: ",0) == 0 || str_find(last[5],"fell back: ",0) == 0) ? "strained" : "breathing";
  def ws-now(cfg,meta,organs) {
   let rows = map(organ => {
    let tail = fp-get(fp-get(meta,"tails",[]),wr-text(organ,"name"),[]);
    let last = nil?(tail) ? nothing() : reverse(tail)[0];
    let status = ws-status(cfg,last);
    fp-object([["name",wr-text(organ,"name")],["label",wr-text(organ,"label")],["description",wr-text(organ,"description")],["status",status],["latency_ms",nothing?(last) ? nothing() : last[4]],["last_sample_at",nothing?(last) ? nothing() : last[1]],["detail",nothing?(last) || (status != "strained" && status != "silent") ? nothing() : last[5]]]);
   },organs);
   let open = fp-get(meta,"open",[]);
   let statuses = map(row => wr-text(row,"status"),rows);
   let overall = any?(s => s == "silent",statuses) || any?(r => r[4] == "silent",open) ? "silent" : !nil?(open) || any?(s => s == "strained",statuses) ? "strained" : all?(s => s == "unknown",statuses) ? "unknown" : "breathing";
   fp-object([["overall",overall],["checked_at",fp-stamp(now_unix_ms())],["witness_started_at",fp-stamp(fp-get(meta,"started_at",0))],["organs",rows],["ongoing_silences",map(r => fp-object([["id",r[0]],["organ",r[1]],["started_at",r[2]],["severity",r[4]],["duration_seconds",ws-duration(r[2],now_unix_ms())]]),sort-by(open,r => fp-time(r[2])))]]);
  }
  def ws-duration(start,end) { let d = (end - fp-time(start))/1000; d<0 ? 0 : d; }
  def ws-rank(hist, rank, n) = nil?(hist) ? nothing() : n+hist[0][1] >= rank ? hist[0][0] : ws-rank(hist[1:],rank,n+hist[0][1]);
  def ws-percentiles(hist) = ws-percentiles-ordered(fp-histogram(hist));
  def ws-percentiles-ordered(ordered) {
   let n = foldl((count,p) => count+p[1],0,ordered);
   n == 0 ? [nothing(),nothing()] : [ws-rank(ordered,(n*50+99)/100,0),ws-rank(ordered,(n*95+99)/100,0)];
  }
  def ws-uptime(n,fail) = n == 0 ? 0.0 : round_ndigits(100.0*(n - fail)/n,2);
  def ws-history(cfg,meta,organs,days) = ws-history-at(cfg,meta,organs,days,now_unix_ms());
  def ws-history-at(cfg,meta,organs,days,now) {
   let since = (now/1000)*1000 - days*86400000;
   let dates = map(i => fp-day((now/86400000 - days+1+i)*86400000),range(0,days));
   let boundary = nw-raw-day(cfg,fp-day(since),since);
   let histories = map(organ => {
    let name = wr-text(organ,"name");
    let loaded = map(day => [day,nw-card(cfg,meta,day,name)],dates);
    let daily = map(page => {
     let day = page[0]; let s = page[1];
     fp-object([["date",day],["status",s[1] == 0 ? "unknown" : s[2]*2>s[1] ? "silent" : 100.0*(s[1]-s[2])/s[1]>=99.5 ? "breathing" : "strained"],["samples",s[1]],["failures",s[2]],["latency_p50_ms",s[3]],["latency_p95_ms",s[4]]]);
    },loaded);
    let initial = nw-stats-rows([0,0,0,[]],filter(row => row[2] == name,boundary));
    let blocks = fp-range-cover(now/86400000 - days+1,now/86400000,6);
    let summaries = map(block => nw-node(cfg,fp-get(meta,"days",[]),block[0],block[1],name),blocks);
    let total = foldl((s,d) => [0,s[1]+d[1],s[2]+d[2],cons(d[3],s[3])],[0,initial[1],initial[2],[initial[3]]],summaries);
    let percentiles = fp-weighted-percentiles(total[3],[50,95]);
    [total[1],fp-object([["name",name],["label",wr-text(organ,"label")],["description",wr-text(organ,"description")],["uptime_pct",ws-uptime(total[1],total[2])],["latency_p50_ms",percentiles[0]],["latency_p95_ms",percentiles[1]],["daily",daily]])];
   },organs);
   let observed = filter(h => h[0]>0,histories);
   let worst = nil?(observed) ? nothing() : foldl((w,h) => node_value(json-object-get(h[1],"uptime_pct")) < node_value(json-object-get(w[1],"uptime_pct")) ? h : w,observed[0],observed);
   let pct = nothing?(worst) ? 0.0 : node_value(json-object-get(worst[1],"uptime_pct"));
   let avg = nil?(observed) ? 0.0 : round_ndigits(foldl((n,h) => n+node_value(json-object-get(h[1],"uptime_pct")),0.0,observed)/len(observed),2);
   fp-object([["days",days],["generated_at",fp-stamp(now)],["overall",fp-object([["uptime_pct",avg],["worst_uptime_pct",pct],["worst_organ",nothing?(worst) || pct>=100 ? nothing() : wr-text(worst[1],"name")]])],["organs",map(h => h[1],histories)]]);
  }
  def ws-silence-rows(cfg,meta,days) {
   let now = now_unix_ms(); let since = (now/1000)*1000 - days*86400000;
   let open = fp-get(meta,"open",[]);
   let ends = fp-get(meta,"silence_ends",[]);
   let buckets = filter(b => b[1]>=since || fp-get(ends,b[0],[-1,0])[1]>=since || any?(r => r[0]/256 == b[0],open),fp-get(meta,"buckets",[]));
   let rows = foldl((out,b) => append(out,filter(r => fp-time(r[2])>=since || nothing?(r[3]) || fp-time(r[3])>=since,fp-required(nw-path(cfg,"silences/" ++ fp-pad(b[0],8) ++ ".fkb"))[1])),[],buckets);
   sort-by(rows,r => 0 - fp-time(r[2]));
  }
  def ws-silences(cfg,meta,organs,days) {
   let now = now_unix_ms();
   let output = map(r => {
    let organ = filter(o => wr-text(o,"name") == r[1],organs);
    fp-object([["id",r[0]],["organ",r[1]],["organ_label",nil?(organ) ? r[1] : wr-text(organ[0],"label")],["started_at",r[2]],["ended_at",r[3]],["duration_seconds",ws-duration(r[2],nothing?(r[3]) ? now : fp-time(r[3]))],["severity",r[4]],["note",r[5]]]);
   },ws-silence-rows(cfg,meta,days));
   fp-object([["days",days],["generated_at",fp-stamp(now)],["silences",output]]);
  }
 }
}
