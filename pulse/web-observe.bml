// Changed-effect observation only: complete native HTML and exact weighted ranks.
// stdin: {"base":"http://127.0.0.1:8100","requests":[["web","/pulse"]]}
// preludes: form/form-stdlib/core.fk form/form-stdlib/json.fk form/form-stdlib/bml/stdin-source.bml ../pulse/web.bml
section [form.bml] {
 let cfg = wr-overlay(wr-config(),parse-json("pulse-web-observation",stdin-text()));
 let chunks = [[[10,4],[20,2],[30,1]],[[10,2],[20,3],[40,1]],[]];
 let selected = fp-weighted-percentiles(chunks,[50,95]);
 let expected = ws-percentiles-ordered(fp-histogram-chunks(chunks));
 let exact = selected[0] == expected[0] && selected[1] == expected[1] && nothing?(fp-weighted-percentiles([],[50])[0]) && fp-weighted-percentiles([[[1.25,3],[2.5,1]]],[95])[0] == 2.5;
 let escaped = fh-text("<a&\"'") == "&lt;a&amp;&quot;&#39;";
 let requests = json-object-has?(cfg,"requests") ? map(row => map(v => node_value(v),node_children(row)),wr-array(cfg,"requests")) : [["web","/pulse"]];
 let rows = map(request => {
  let began = host_monotonic_ms();
  let response = wr-fetch("GET",wr-text(cfg,"base") ++ request[1],"",0);
  let elapsed = host_monotonic_ms()-began;
  let page = response[1]; let valid = response[0] == 200 && str_find(page,"<!doctype html>",0) == 0 && str_find(page,"</body></html>",0) == len(page)-14 && str_find(page,"<script",0)<0 && str_find(page,"/pulse?days=180",0)>0;
  let captured = len(wr-text(cfg,"html_path")) == 0 ? 0 : write_file_text(wr-text(cfg,"html_path"),page);
  let policy = str_find(response[3],"no-transform",0)>=0 && str_find(response[3],"script-src 'none'",0)>=0;
  !valid || !policy ? form_error("native pulse page or response boundary incomplete: " ++ request[0]) : fp-object([["surface",request[0]],["status",response[0]],["latency_ms",elapsed],["html_bytes",len(page)],["hydration_bytes",0],["response_policy","no-transform; script-src none"]]);
 },requests);
 !exact || !escaped ? form_error("weighted rank or HTML escaping observation failed") : fp-emit(fp-object([["native","fkwu"],["weighted_ranks","exact"],["html_escaping","observed"],["observations",rows]]));
}
