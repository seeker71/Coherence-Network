// Read-only file-format import, authored in BML. The database engine is absent.
// Format reference: https://sqlite.org/fileformat2.html
import ../pulse/form-persistence.bml;
section [form.bml] {
 class SQLiteFileImport {
  def sfi-uint(s, at, n, v) = n == 0 ? v : sfi-uint(s,at+1,n - 1,v*256+str_byte_at(s,at));
  def sfi-var(s, at, n, v) { let b = str_byte_at(s,at); n == 8 ? [v*256+b,at+1] : b < 128 ? [v*128+b,at+1] : sfi-var(s,at+1,n+1,v*128+b - 128); }
  def sfi-open(path) {
   let head = read_file_slice(path,0,100);
   substring(head,0,15) != "SQLite format 3" ? form_error("native import: source is not a SQLite snapshot") : {
    let page = sfi-uint(head,16,2,0);
    let size = page == 1 ? 65536 : page;
    let pager = record_new(0,"path",path,"size",size,"usable",size - str_byte_at(head,20),"cache_at",-1,"cache","","wal",record_new(0),"pages",file_size(path)/size);
    let wal = sfi-wal(pager,path ++ "-wal");
    pager;
   };
  }
  // Only frames through the last commit are visible. A stopped witness's WAL
  // is part of the snapshot, never silently ignored during migration.
  def sfi-wal(pager, path) {
   let size = file_size(path);
   size < 32 ? 0 : {
    let h = read_file_slice(path,0,32);
    let magic = sfi-uint(h,0,4,0);
    let little = magic == 931071618;
    let sum = sfi-checksum(substring(h,0,24),0,little,[0,0]);
    let valid = (magic == 931071618 || magic == 931071619) && sfi-uint(h,8,4,0) == record_get(pager,"size") && sum[0] == sfi-uint(h,24,4,0) && sum[1] == sfi-uint(h,28,4,0);
    let frame = record_get(pager,"size")+24;
    let count = (size - 32)/frame;
    let pending = record_new(0);
    let committed = record_new(0);
    let scanned = !valid ? form_error("native import: invalid WAL header") : sfi-wal-frames(pager,path,h,frame,0,count,pending,committed,little,sum);
    record_set(pager,"wal",committed);
   };
  }
  def sfi-word(s,at,little) = little ? str_byte_at(s,at)+str_byte_at(s,at+1)*256+str_byte_at(s,at+2)*65536+str_byte_at(s,at+3)*16777216 : sfi-uint(s,at,4,0);
  def sfi-checksum(s,at,little,prior) = at >= len(s) ? prior : {
   let modulus = 65536*65536;
   let a = (prior[0]+sfi-word(s,at,little)+prior[1])%modulus;
   let b = (prior[1]+sfi-word(s,at+4,little)+a)%modulus;
   sfi-checksum(s,at+8,little,[a,b]);
  };
  def sfi-wal-frames(pager,path, head, width, i, count, pending, committed,little,prior) = i >= count ? 0 : {
   let at = 32+i*width;
   let h = read_file_slice(path,at,24);
   let body = read_file_slice(path,at+24,width - 24);
   let sum = sfi-checksum(body,0,little,sfi-checksum(substring(h,0,8),0,little,prior));
   substring(h,8,16) != substring(head,16,24) || sum[0] != sfi-uint(h,16,4,0) || sum[1] != sfi-uint(h,20,4,0) ? 0 : {
    let stored = record_set(pending,sfi-uint(h,0,4,0).str(),[path,at+24]);
    let mark = sfi-uint(h,4,4,0);
    let publish = mark == 0 ? 0 : foldl((n,key) => record_set(committed,key,record_get(pending,key)),0,record_keys(pending));
    let sized = mark == 0 ? 0 : record_set(pager,"pages",mark);
    sfi-wal-frames(pager,path,head,width,i+1,count,pending,committed,little,sum);
   };
  };
  def sfi-page(pager, page) {
   let bounded = page < 1 || page > record_get(pager,"pages") ? form_error("native import: page outside committed database") : 0;
   let key = page.str();
   let wal = record_get(pager,"wal");
   record_has(wal,key) ? { let ref = record_get(wal,key); read_file_slice(ref[0],ref[1],record_get(pager,"size")); } : {
    let at = (page - 1)*record_get(pager,"size");
    let block = (at/1048576)*1048576;
    let loaded = record_get(pager,"cache_at") == block ? 0 : { let put = record_set(pager,"cache",read_file_slice(record_get(pager,"path"),block,1048576)); record_set(pager,"cache_at",block); };
    substring(record_get(pager,"cache"),at - block,at - block+record_get(pager,"size"));
   };
  }
  def sfi-overflow(pager, page, n, out) = n <= 0 ? hch-join(reverse(out),"") : {
   let bytes = sfi-page(pager,page);
   let use = n < record_get(pager,"usable")-4 ? n : record_get(pager,"usable")-4;
   sfi-overflow(pager,sfi-uint(bytes,0,4,0),n - use,cons(substring(bytes,4,4+use),out));
  };
  def sfi-payload(pager, page, at, n, table) {
   let u = record_get(pager,"usable");
   let max = table ? u - 35 : ((u - 12)*64)/255-23;
   let min = ((u - 12)*32)/255-23;
   let k = min+(n - min)%(u - 4);
   let local = n <= max ? n : k <= max ? k : min;
   let first = substring(page,at,at+local);
   n == local ? first : first ++ sfi-overflow(pager,sfi-uint(page,at+local,4,0),n - local,[]);
  }
  def sfi-size(t) = t == 0 || t == 8 || t == 9 ? 0 : t <= 4 ? t : t == 5 ? 6 : t <= 7 ? 8 : (t - 12)/2;
  def sfi-signed(s,at,n) = sfi-uint(s,at+1,n - 1,str_byte_at(s,at)>=128 ? str_byte_at(s,at) - 256 : str_byte_at(s,at));
  def sfi-value(s, at, t) = t == 0 ? nothing() : t == 8 ? 0 : t == 9 ? 1 : t <= 6 ? sfi-signed(s,at,sfi-size(t)) : t == 7 ? node_value(bytes_to_recipe(append([70,79,82,77,66,73,78,50,0,0,0,0,0,0,0,2],reverse(fp-bytes(substring(s,at,at+8),7,[]))))) : substring(s,at,at+sfi-size(t));
  def sfi-fields(s, at, end, data, out) = at >= end ? reverse(out) : { let t = sfi-var(s,at,0,0); sfi-fields(s,t[1],end,data+sfi-size(t[0]),cons(sfi-value(s,data,t[0]),out)); };
  def sfi-record(s) { let h = sfi-var(s,0,0,0); sfi-fields(s,h[1],h[0],h[0],[]); }
  def sfi-cell(pager, page, at, kind) {
   let p = kind == 2 ? at+4 : at;
   let n = sfi-var(page,p,0,0);
   let rowid = kind == 13 ? sfi-var(page,n[1],0,0) : [nothing(),n[1]];
   [rowid[0],sfi-record(sfi-payload(pager,page,rowid[1],n[0],kind == 13))];
  }
  // receive gets a leaf-sized batch, so the importer need not hold a table.
  def sfi-walk(pager, number, receive) {
   let page = sfi-page(pager,number);
   let h = number == 1 ? 100 : 0;
   let kind = str_byte_at(page,h);
   let n = sfi-uint(page,h+3,2,0);
   let interior = kind == 2 || kind == 5;
   let pointers = map(i => sfi-uint(page,h+(interior ? 12 : 8)+i*2,2,0),range(0,n));
   !interior ? receive(map(at => sfi-cell(pager,page,at,kind),pointers)) : {
    let children = foldl((acc,at) => { let left = sfi-walk(pager,sfi-uint(page,at,4,0),receive); kind == 2 ? receive([sfi-cell(pager,page,at,kind)]) : 0; },0,pointers);
    sfi-walk(pager,sfi-uint(page,h+8,4,0),receive);
   };
  }
  def sfi-tables(pager) { let rows = record_new(0,"rows",[]); let scan = sfi-walk(pager,1,batch => record_set(rows,"rows",append(record_get(rows,"rows"),map(row => row[1],batch)))); record_get(rows,"rows"); }
  // Ordered WITHOUT ROWID trees expose a reusable leading-key group read.
  def sfi-group(pager,number,key,receive) {
   let page = sfi-page(pager,number); let h = number == 1 ? 100 : 0;
   let kind = str_byte_at(page,h); let n = sfi-uint(page,h+3,2,0);
   let interior = kind == 2;
   let cells = map(i => sfi-uint(page,h+(interior ? 12 : 8)+i*2,2,0),range(0,n));
   kind == 10 ? receive(filter(row => row[1][0] == key,map(at => sfi-cell(pager,page,at,kind),cells))) : !interior ? form_error("native import: ordered group needs an index tree") : {
    let lower = foldl((lo,at) => {
     let row = sfi-cell(pager,page,at,kind); let upper = row[1][0];
     let scanned = (nothing?(lo) || sort-str-le?(lo,key)) && sort-str-le?(key,upper) ? sfi-group(pager,sfi-uint(page,at,4,0),key,receive) : 0;
     let own = upper == key ? receive([row]) : 0;
     upper;
    },nothing(),cells);
    nothing?(lower) || sort-str-le?(lower,key) ? sfi-group(pager,sfi-uint(page,h+8,4,0),key,receive) : 0;
   };
  }
  // Rowid separators skip already imported subtrees during the live handoff.
  def sfi-after(pager,number,after,receive) {
   sfi-range(pager,number,after,sfi-edge(pager,number,true),receive);
  }
  def sfi-range(pager,number,after,through,receive) {
   let page = sfi-page(pager,number); let h = number == 1 ? 100 : 0;
   let kind = str_byte_at(page,h); let n = sfi-uint(page,h+3,2,0);
   kind == 13 ? receive(filter(row => row[0]>after && row[0]<=through,map(i => sfi-cell(pager,page,sfi-uint(page,h+8+i*2,2,0),kind),range(0,n)))) : kind != 5 ? form_error("native import: rowid continuation needs a table tree") : {
    let lower = foldl((lo,i) => { let at = sfi-uint(page,h+12+i*2,2,0); let upper = sfi-var(page,at+4,0,0)[0]; let scanned = upper > after && lo < through ? sfi-range(pager,sfi-uint(page,at,4,0),after,through,receive) : 0; upper; },0,range(0,n));
    lower < through ? sfi-range(pager,sfi-uint(page,h+8,4,0),after,through,receive) : 0;
   };
  }
  def sfi-edge(pager,number,last) {
   let page = sfi-page(pager,number); let h = number == 1 ? 100 : 0;
   let kind = str_byte_at(page,h); let n = sfi-uint(page,h+3,2,0);
   kind == 5 ? sfi-edge(pager,last ? sfi-uint(page,h+8,4,0) : sfi-uint(page,sfi-uint(page,h+12,2,0),4,0),last) : n == 0 ? 0 : sfi-cell(pager,page,sfi-uint(page,h+8+(last ? n - 1 : 0)*2,2,0),kind)[0];
  }
  def sfi-root(pager,name) { let found = filter(row => row[0] == "table" && row[1] == name,sfi-tables(pager)); nil?(found) ? form_error("native import: missing table " ++ name) : found[0][3]; }
 }
}
