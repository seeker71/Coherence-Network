// Form-owned indexed witness store. Typed pages are native Recipe snapshots;
// complete transaction frames are the recovery authority, indexes are replayable.
import ../pulse/form-persistence.bml;
section [form.bml] {
 class NativeWitnessStore {
  def nw-unique(xs) = foldl((out,x) => any?(v => v == x,out) ? out : cons(x,out),[],xs);
  def nw-root(cfg) = wr-text(cfg,"store_path");
  def nw-path(cfg, tail) = nw-root(cfg) ++ "/" ++ tail;
  def nw-meta(cfg) = fp-required(nw-path(cfg,"state.fkb"));
  def nw-dir(cfg, tail) = hch-mkdirs(nw-path(cfg,tail));
  def nw-blank() = [["format",1],["seq",0],["samples_total",0],["max_rowid",0],["max_silence",0],["started_at",now_unix_ms()],["tails",[]],["days",[]],["buckets",[]],["open",[]],["journal",0],["offset",0]];
  def nw-key(s) = fp-hex(fp-bytes(s,len(s) - 1,[]));
  def nw-observed(row) = nothing?(row[5]) || str_find(row[5],"unobserved: ",0) != 0;
  def nw-sort-rows(rows) = fp-order(rows,row => [fp-time(row[1]),row[0]],(a,b) => a[0] == b[0] ? a[1]<=b[1] : a[0]<=b[0]);
  def nw-tail(rows) { let sorted = nw-sort-rows(rows); drop(len(sorted)>20 ? len(sorted) - 20 : 0,sorted); }
  def nw-tails(meta, rows) {
   let names = nw-unique(map(row => row[2],rows));
   foldl((tails,name) => fp-set(tails,name,nw-tail(append(fp-get(tails,name,[]),filter(row => row[2] == name,rows)))),fp-get(meta,"tails",[]),names);
  }
  def nw-stat-path(cfg,day,organ) = nw-path(cfg,"days/" ++ day ++ "/" ++ nw-key(organ) ++ ".fkb");
  def nw-stat(cfg,day,organ) = fp-read(nw-stat-path(cfg,day,organ),[0,0,0,[]]);
  def nw-stats-rows(stat,rows) {
   let observed = filter(row => nw-observed(row),rows);
   let latency = map(row => [row[4],1],filter(row => row[3] != 0 && !nothing?(row[4]),observed));
   [stat[0],stat[1]+len(observed),stat[2]+len(filter(row => row[3] == 0,observed)),fp-histogram(append(stat[3],latency))];
  }
  def nw-raw(cfg,day,seq,rows) {
   let dir = "raw/" ++ day;
   let made = nw-dir(cfg,dir);
   let indexpath = nw-path(cfg,dir ++ "/index.fkb");
   let index = fp-read(indexpath,[0,[]]);
   index[0] >= seq ? 0 : {
    let parts = index[1];
    let last = nil?(parts) ? [-1,0,0,0] : reverse(parts)[0];
    let number = last[3]+len(rows) > 4096 ? last[0]+1 : last[0]<0 ? 0 : last[0];
    let path = nw-path(cfg,dir ++ "/part-" ++ fp-pad(number,8) ++ ".fkb");
    let prior = number == last[0] ? fp-required(path) : fp-read(path,[0,[]]);
    let contents = prior[0] >= seq ? prior[1] : append(prior[1],rows);
    let put = prior[0] >= seq ? 0 : fp-write(path,[seq,contents]);
    let times = map(row => fp-time(row[1]),contents);
    let entry = [number,foldl((n,v) => v<n ? v : n,times[0],times),foldl((n,v) => v>n ? v : n,times[0],times),len(contents)];
    fp-write(indexpath,[seq,append(filter(p => p[0] != number,parts),[entry])]);
   };
  }
  def nw-day(cfg,day,seq,rows,indexed) {
   let raw = nw-raw(cfg,day,seq,rows);
   let made = nw-dir(cfg,"days/" ++ day);
   let pages = foldl((out,name) => {
    let prior = nw-stat(cfg,day,name);
    let current = prior[0] >= seq ? prior : nw-stats-seq(nw-stats-rows(prior,filter(row => row[2] == name,rows)),seq);
    let stat = prior[0] >= seq ? out : cons([nw-stat-path(cfg,day,name),current],out);
    !indexed ? stat : {
     let cardpath = nw-card-path(cfg,day,name); let made = nw-dir(cfg,"cards/" ++ day);
     let card = fp-read(cardpath,[-1,0,0,nothing(),nothing()]);
     card[0]>=current[0] ? stat : cons([cardpath,nw-card-value(current)],stat);
    };
   },[],nw-unique(map(row => row[2],rows)));
   fp-write-batch(pages);
  }
  def nw-stats-seq(stat,seq) = [seq,stat[1],stat[2],stat[3]];
  def nw-card-path(cfg,day,name) = nw-path(cfg,"cards/" ++ day ++ "/" ++ nw-key(name) ++ ".fkb");
  def nw-card-value(stat) { let p = fp-ordered-percentiles(stat[3],[50,95]); [stat[0],stat[1],stat[2],p[0],p[1]]; }
  def nw-card(cfg,meta,day,name) = file_size(nw-stat-path(cfg,day,name)) >= 0 ? fp-required(nw-card-path(cfg,day,name)) : [0,0,0,nothing(),nothing()];
  def nw-day-number(day) = fp-time(day ++ "T00:00:00Z")/86400000;
  def nw-range-path(cfg,level,bucket,name) = nw-path(cfg,"ranges/" ++ level.str() ++ "/" ++ bucket.str() ++ "/" ++ nw-key(name) ++ ".fkb");
  def nw-node(cfg,days,level,bucket,name) = level == 0 ? nw-stat(cfg,fp-day(bucket*86400000),name) : any?(day => nw-day-number(day)/fp-block-size(level) == bucket,days) ? fp-required(nw-range-path(cfg,level,bucket,name)) : [0,0,0,[]];
  def nw-range-levels(cfg,days,changed,names,seq,level) = level>6 ? 0 : {
   let buckets = nw-unique(map(day => nw-day-number(day)/fp-block-size(level),changed));
   let pages = foldl((out,bucket) => {
    let made = nw-dir(cfg,"ranges/" ++ level.str() ++ "/" ++ bucket.str());
    foldl((items,name) => {
     let path = nw-range-path(cfg,level,bucket,name); let old = fp-read(path,[-1,0,0,[]]);
     old[0]>=seq ? items : {
      let left = nw-node(cfg,days,level - 1,bucket*2,name); let right = nw-node(cfg,days,level - 1,bucket*2+1,name);
      cons([path,[seq,left[1]+right[1],left[2]+right[2],fp-histogram-chunks([left[3],right[3]])]],items);
     };
    },out,names);
   },[],buckets);
   let saved = fp-write-batch(pages);
   nw-range-levels(cfg,days,changed,names,seq,level+1);
  };
  def nw-index-build(cfg,name,changed) {
   let meta = nw-meta(cfg); let days = fp-get(meta,"days",[]); let seq = fp-get(meta,"seq",0);
   let cards = map(day => { let made = nw-dir(cfg,"cards/" ++ day); [nw-card-path(cfg,day,name),nw-card-value(nw-stat(cfg,day,name))]; },changed);
   let saved = fp-write-batch(cards);
   nw-range-levels(cfg,days,changed,[name],seq,1);
  }
  def nw-source-days(cfg,days) = map(day => [day,fp-required(nw-path(cfg,"raw/" ++ day ++ "/index.fkb"))[0]],days);
  // Closed intervals can begin before the requested window. Their end bound
  // belongs beside the start bound, keyed by the source bucket's own sequence.
  def nw-end-index(cfg,meta,numbers) = foldl((out,number) => {
   let page = fp-required(nw-path(cfg,"silences/" ++ fp-pad(number,8) ++ ".fkb"));
   let prior = fp-get(out,number,[-1,0]);
   prior[0] == page[0] ? out : {
    let end = foldl((n,row) => nothing?(row[3]) ? n : { let at = fp-time(row[3]); at>n ? at : n; },0,page[1]);
    fp-set(out,number,[page[0],end]);
   };
  },fp-get(meta,"silence_ends",[]),numbers);
  def nw-index-ensure(cfg,organs) = nw-locked(cfg,meta => {
   let sources = nw-source-days(cfg,fp-get(meta,"days",[])); let prior = fp-get(meta,"query_days",[]);
   let changed = map(p => p[0],filter(p => fp-get(meta,"query_index",0) != 1 || fp-get(prior,p[0],-1) != p[1],sources));
   let names = map(organ => wr-text(organ,"name"),organs);
   let built = map(name => {
    let new_organ = !any?(old => old == name,fp-get(meta,"query_organs",[]));
    let needed = new_organ ? map(p => p[0],sources) : changed;
    nil?(needed) ? "" : fp-task(cfg,"../pulse/index.bml",wr-overlay(cfg,fp-object([["organ",name],["changed_days",needed]])));
   },names);
   let ends = nw-end-index(cfg,meta,map(b => b[0],fp-get(meta,"buckets",[])));
   let current = fp-set(fp-set(fp-set(fp-set(fp-set(meta,"query_index",1),"query_days",sources),"query_seq",fp-get(meta,"seq",0)),"query_organs",names),"silence_ends",ends);
   let saved = fp-write(nw-path(cfg,"state.fkb"),current); let stable = host_sync(); current;
  });
  def nw-bucket(cfg,number) = fp-read(nw-path(cfg,"silences/" ++ fp-pad(number,8) ++ ".fkb"),[0,[]]);
  def nw-buckets(cfg,meta,seq,changes) {
   let made = nw-dir(cfg,"silences");
   foldl((catalog,number) => {
    let old = nw-bucket(cfg,number);
    let changed = filter(row => row[0]/256 == number,changes);
    let ids = map(row => row[0],changed);
    let rows = old[0] >= seq ? old[1] : sort-by(append(filter(row => !any?(id => id == row[0],ids),old[1]),changed),row => row[0]);
    let saved = old[0] >= seq ? 0 : fp-write(nw-path(cfg,"silences/" ++ fp-pad(number,8) ++ ".fkb"),[seq,rows]);
    let max = foldl((n,row) => fp-time(row[2]) > n ? fp-time(row[2]) : n,0,rows);
    fp-set(catalog,number,max);
   },fp-get(meta,"buckets",[]),nw-unique(map(row => row[0]/256,changes)));
  }
  def nw-project(cfg,meta,txn,number,end) {
   let seq = txn[0]; let rows = txn[1]; let changes = txn[2];
   seq <= fp-get(meta,"seq",0) ? meta : {
    let days = nw-unique(map(row => substring(row[1],0,10),rows));
    let published = foldl((n,day) => nw-day(cfg,day,seq,filter(row => substring(row[1],0,10) == day,rows),fp-get(meta,"query_index",0) == 1),0,days);
    let all_days = sort-strs(nw-unique(append(fp-get(meta,"days",[]),days)));
    let names = nw-unique(append(map(row => row[2],rows),map(organ => wr-text(organ,"name"),node_children(parse-json("pulse-index-organs",read_file("../pulse/organs.json"))))));
    let indexed = fp-get(meta,"query_index",0) == 1 && !nil?(days) ? nw-range-levels(cfg,all_days,days,names,seq,1) : 0;
    let buckets = nw-buckets(cfg,meta,seq,changes);
    let ids = map(row => row[0],changes);
    let open = filter(row => nothing?(row[3]),append(filter(row => !any?(id => id == row[0],ids),fp-get(meta,"open",[])),changes));
    let updates = [["seq",seq],["samples_total",fp-get(meta,"samples_total",0)+len(rows)],["max_rowid",foldl((n,row) => row[0]>n ? row[0] : n,fp-get(meta,"max_rowid",0),rows)],["max_silence",foldl((n,row) => row[0]>n ? row[0] : n,fp-get(meta,"max_silence",0),changes)],["tails",nw-tails(meta,rows)],["days",sort-strs(nw-unique(append(fp-get(meta,"days",[]),days)))],["buckets",buckets],["open",open],["journal",number],["offset",end]];
    let query_days = foldl((out,day) => fp-set(out,day,seq),fp-get(meta,"query_days",[]),days);
    let next = foldl((m,p) => fp-set(m,p[0],p[1]),meta,updates);
    let with_ends = fp-set(next,"silence_ends",nw-end-index(cfg,meta,nw-unique(map(row => row[0]/256,changes))));
    let current = fp-get(meta,"query_index",0) == 1 ? fp-set(fp-set(with_ends,"query_days",query_days),"query_seq",seq) : with_ends;
    // Pages reach stable storage before their checkpoint can skip replay.
    let stable = host_sync();
    let saved = fp-write(nw-path(cfg,"state.fkb"),current);
    current;
   };
  }
  def nw-log(cfg,number) = nw-path(cfg,"transactions/" ++ fp-pad(number,8) ++ ".fpl");
  def nw-recover-at(cfg,meta,number,offset) {
   let path = nw-log(cfg,number);
   file_size(path) < 0 ? meta : {
    let box = record_new(0,"meta",meta);
    let end = fp-replay(path,offset,(txn,at) => record_set(box,"meta",nw-project(cfg,record_get(box,"meta"),txn,number,at)));
    let current = record_get(box,"meta");
    end < file_size(path) ? {
     let next = fp-set(fp-set(current,"journal",number+1),"offset",0);
     let saved = fp-write(nw-path(cfg,"state.fkb"),next);
     // The old log stays replayable until its replacement checkpoint is durable.
     // A crash before archive leaves extra evidence, never a missing authority.
     let checkpoint = host_sync();
     let kept = host_path_rename(path,path ++ ".torn-" ++ now_unix_ms().str());
     let moved = kept != 0 ? form_error("native recovery tail could not be retained: " ++ path) : host_sync();
     next;
    } : nw-recover-at(cfg,current,number+1,0);
   };
  }
  def nw-recover(cfg) { let meta = nw-meta(cfg); let current = nw-recover-at(cfg,meta,fp-get(meta,"journal",0),fp-get(meta,"offset",0)); let stable = current == meta ? 0 : host_sync(); current; }
  def nw-commit(cfg,meta,rows,changes) {
   let seq = fp-get(meta,"seq",0)+1;
   let made = nw-dir(cfg,"transactions");
   let oldnum = fp-get(meta,"journal",0);
   let number = file_size(nw-log(cfg,oldnum)) >= 67108864 ? oldnum+1 : oldnum;
   let end = fp-frame(nw-log(cfg,number),[seq,rows,changes]);
   let durable = host_sync();
   let current = nw-project(cfg,meta,[seq,rows,changes],number,end);
   let published = host_sync();
   current;
  }
  def nw-locked(cfg,read) { let held = fp-lock(nw-root(cfg)); let meta = nw-recover(cfg); let value = read(meta); let released = fp-unlock(nw-root(cfg)); value; }
  def nw-create(cfg) { let dir = hch-mkdirs(nw-root(cfg)); let present = file_size(nw-path(cfg,"state.fkb")) >= 0; present ? nw-meta(cfg) : { let m = nw-blank(); let written = fp-write(nw-path(cfg,"state.fkb"),m); m; }; }
  def nw-raw-day(cfg,day,since) {
   let index = fp-read(nw-path(cfg,"raw/" ++ day ++ "/index.fkb"),[0,[]]);
   foldl((rows,entry) => entry[2] < since ? rows : {
    let page = fp-required(nw-path(cfg,"raw/" ++ day ++ "/part-" ++ fp-pad(entry[0],8) ++ ".fkb"))[1];
    // The committed page bounds already prove whole-page inclusion. Parse
    // individual timestamps only in a page that straddles the moving cutoff.
    append(rows,entry[1]>=since ? page : filter(row => fp-time(row[1])>=since,page));
   },[],index[1]);
  }
 }
}
