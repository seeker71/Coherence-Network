; grocery-duplicate-groups-band.fk — the duplicate-review policy.
; preludes: ../../api/app/form_recipes/endpoint_grocery_duplicate_groups.fk
; Verdict 127 proves: a run of repeats groups in creation order; a singleton
; is never a group; the window is measured from the run's FIRST entry, not
; the previous one; the window edge is inclusive; different signatures never
; mix even when interleaved in time; an empty wire is no groups; many runs
; come back in wire order.
(do
  (let run
    (grocery-duplicate-main "0|a|100;1|a|200;2|a|300" 43200))
  (let singleton
    (grocery-duplicate-main "0|a|100;1|b|100" 43200))
  (let from-first
    (grocery-duplicate-main "0|a|0;1|a|30000;2|a|60000" 43200))
  (let edge
    (grocery-duplicate-main "0|a|0;1|a|43200;2|a|43201" 43200))
  (let signatures
    (grocery-duplicate-main "0|a|0;1|a|1;2|b|0;3|b|1" 43200))
  (let nothing
    (grocery-duplicate-main "" 43200))
  (let many
    (grocery-duplicate-main "0|a|0;1|a|1;2|b|5;3|c|0;4|c|9" 43200))
  (add
    (if
      (and
        (eq (len run) 1)
        (and
          (eq (len (head run)) 3)
          (and (eq (nth (head run) 0) 0) (eq (nth (head run) 2) 2))))
      1
      0)
    (add
      (if (eq (len singleton) 0) 2 0)
      (add
        (if
          (and
            (eq (len from-first) 1)
            (and (eq (len (head from-first)) 2) (eq (nth (head from-first) 1) 1)))
          4
          0)
        (add
          (if
            (and
              (eq (len edge) 1)
              (and (eq (len (head edge)) 2) (eq (nth (head edge) 1) 1)))
            8
            0)
          (add
            (if
              (and
                (eq (len signatures) 2)
                (and
                  (eq (nth (head signatures) 1) 1)
                  (eq (nth (nth signatures 1) 0) 2)))
              16
              0)
            (add
              (if (eq (len nothing) 0) 32 0)
              (if
                (and
                  (eq (len many) 2)
                  (and
                    (eq (nth (head many) 0) 0)
                    (eq (nth (nth many 1) 0) 3)))
                64
                0))))))))
