// Publish the unchanged pinned native resources at the source home's canonical
// runtime/ path while the corrected image assembles. No alias or new kernel.
// stdin: {"host":"root@host","key":"/local/key","source":"/host/repo/form/runtime","target":"api-container:/app/runtime"}
// preludes: form/form-stdlib/core.fk form/form-stdlib/json.fk form/form-stdlib/bml/stdin-source.bml form/form-stdlib/bml/host-child.bml
section [form.bml] {
 class NativeImageLayoutCare {
  def nilc-text(doc, key) = json-string-value(json-object-get(doc, key)) ?? "";
  def nilc-publish(doc) {
   let argv = ["ssh", "-i", nilc-text(doc, "key"), "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", nilc-text(doc, "host"), "docker", "cp", nilc-text(doc, "source") ++ "/.", nilc-text(doc, "target")];
   let run = hch-run("native-image-layout-care", argv, "", hch-by(30000));
   hch-ok?(run) ? "Pinned native runtime resources published at the canonical source home; the corrected image retires the former path." : form_error("native image layout care failed; host-child retains the exact resource movement");
  }
 }
 nilc-publish(parse-json("native-image-layout-care", stdin-text()));
}
