// Live graph projections. PostgreSQL owns selection and aggregation; Form owns
// the reusable query shapes, request values and resource lifetime. No portfolio
// cloning, discovery pass, Python model construction or response cache intervenes.
section [form.bml] {
 class GraphProjection {
  def gp-number(key,fallback) = "COALESCE(NULLIF(n.properties->>'" ++ key ++ "','')::double precision," ++ fallback ++ ")";
  def gp-node() = "COALESCE(n.properties,'{}'::jsonb) || jsonb_build_object('id',n.id,'type',n.type,'name',n.name,'description',n.description,'phase',n.phase,'created_at',n.created_at,'updated_at',n.updated_at)";
  def gp-workspace() = "($1::text='' OR COALESCE(n.properties->>'workspace_id','coherence-network')=$1)";
  def gp-visible(parameter) = "n.type <> ALL(ARRAY(SELECT jsonb_array_elements_text($" ++ parameter.str() ++ "::jsonb)))";
  def gp-vitality-source() = "WITH nodes AS MATERIALIZED (SELECT n.id,n.type,n.phase,n.created_at,n.updated_at,CASE WHEN n.type='contributor' THEN jsonb_build_object('worldview_axes',n.properties->'worldview_axes') WHEN n.type='idea' THEN jsonb_build_object('lifecycle_state',n.properties->'lifecycle_state') ELSE '{}'::jsonb END AS properties FROM graph_nodes n WHERE " ++ gp-workspace() ++ " AND " ++ gp-visible(2) ++ ")";
  def gp-node-count() = "WITH counts AS (SELECT n.type,count(*) AS count FROM graph_nodes n WHERE " ++ gp-workspace() ++ " AND ($2::text='' OR n.type=$2) AND " ++ gp-visible(3) ++ " GROUP BY n.type) SELECT jsonb_build_object('total',COALESCE(sum(count),0),'by_type',COALESCE(jsonb_object_agg(type,count),'{}'::jsonb))::text FROM counts";
  def gp-ideas-source() = "WITH raw AS (SELECT n.*, " ++ gp-number("potential_value","0") ++ " AS potential, " ++ gp-number("actual_value","0") ++ " AS actual, " ++ gp-number("estimated_cost","0") ++ " AS cost, " ++ gp-number("actual_cost","0") ++ " AS spent, " ++ gp-number("resistance_risk","1") ++ " AS risk, " ++ gp-number("confidence","0.5") ++ " AS confidence FROM graph_nodes n WHERE n.type='idea' AND " ++ gp-workspace() ++ " AND ($2::text='' OR n.name ILIKE '%'||$2||'%' OR n.description ILIKE '%'||$2||'%') AND ($3::boolean OR NOT (n.id LIKE 'runtime:%' OR n.id LIKE 'runtime-%' OR COALESCE(n.properties->'interfaces','[]'::jsonb) ?| ARRAY['internal','system','machine:internal','agent:internal'])) AND (NOT $4::boolean OR COALESCE(n.properties->>'manifestation_status','none')<>'validated') AND (NOT $5::boolean OR COALESCE((n.properties->>'is_curated')::boolean,false)) AND ($6::text='' OR n.properties->>'pillar'=$6) AND ($7::text='' OR COALESCE(n.properties->'tags','[]'::jsonb) ?& regexp_split_to_array(lower($7),'\\s*,\\s*')) AND ($12::text='' OR n.id=$12 OR n.properties->>'slug'=$12)), scored AS (SELECT raw.*, potential*confidence/GREATEST(cost+risk,0.5) AS free_energy_score, GREATEST(potential-actual,0) AS value_gap, GREATEST(potential-actual,0)*confidence*confidence/(GREATEST(cost-spent,0.1)+GREATEST(risk,0)*0.5) AS marginal_cc_score FROM raw), ranked AS (SELECT scored.*, CASE WHEN $8::text='marginal_cc' THEN marginal_cc_score ELSE free_energy_score END AS score FROM scored), weighted AS (SELECT ranked.*, exp(score-max(score) OVER ()) AS weight FROM ranked), selected AS (SELECT weighted.*, weight/NULLIF(sum(weight) OVER (),0) AS selection_weight FROM weighted ORDER BY score DESC,id LIMIT NULLIF($10::bigint,0) OFFSET $11::bigint), page AS (SELECT " ++ gp-node() ++ " || jsonb_build_object('name',COALESCE(NULLIF(v.content_title,''),n.name),'description',COALESCE(NULLIF(v.content_description,''),n.description),'potential_value',potential,'actual_value',actual,'estimated_cost',cost,'actual_cost',spent,'confidence',confidence,'resistance_risk',risk,'free_energy_score',free_energy_score,'marginal_cc_score',marginal_cc_score,'selection_weight',selection_weight,'value_gap',value_gap,'remaining_cost_cc',GREATEST(cost-spent,0.1),'value_gap_cc',value_gap,'roi_cc',GREATEST(potential-actual,0)/GREATEST(cost-spent,0.1),'slug',COALESCE(NULLIF(n.properties->>'slug',''),n.id)) AS body,n.score,n.id FROM selected n LEFT JOIN LATERAL (SELECT content_title,content_description FROM entity_views WHERE entity_type='idea' AND entity_id=n.id AND lang=$9::text AND status='canonical' ORDER BY updated_at DESC LIMIT 1) v ON true) ";
  def gp-ideas() = gp-ideas-source() ++ "SELECT jsonb_build_object('ideas',COALESCE((SELECT jsonb_agg(body ORDER BY score DESC,id) FROM page),'[]'::jsonb),'summary',(SELECT jsonb_build_object('total_ideas',count(*),'validated_ideas',count(*) FILTER (WHERE properties->>'manifestation_status'='validated'),'unvalidated_ideas',count(*) FILTER (WHERE COALESCE(properties->>'manifestation_status','none')<>'validated'),'total_potential_value',COALESCE(sum(potential),0),'total_actual_value',COALESCE(sum(actual),0),'total_value_gap',GREATEST(COALESCE(sum(potential-actual),0),0)) FROM raw),'pagination',jsonb_build_object('total',(SELECT count(*) FROM raw),'limit',$10::bigint,'offset',$11::bigint,'returned',(SELECT count(*) FROM page),'has_more',$11::bigint+(SELECT count(*) FROM page)<(SELECT count(*) FROM raw)))::text";
  def gp-idea() = gp-ideas-source() ++ "SELECT body::text FROM page";
  def gp-vitality() = gp-vitality-source() ++ ", ideas AS (SELECT *,COALESCE(NULLIF(properties->>'lifecycle_state',''),phase,'gas') AS life FROM nodes WHERE type='idea'), axes AS (SELECT COALESCE((SELECT key FROM jsonb_each_text(CASE WHEN jsonb_typeof(properties->'worldview_axes')='object' THEN properties->'worldview_axes' ELSE '{}'::jsonb END) ORDER BY value::double precision DESC,key LIMIT 1),'_none') AS axis,count(*)::double precision AS count FROM nodes WHERE type='contributor' GROUP BY axis), edges AS (SELECT e.strength FROM graph_edges e WHERE EXISTS(SELECT 1 FROM nodes f WHERE f.id=e.from_id) AND EXISTS(SELECT 1 FROM nodes t WHERE t.id=e.to_id)), phases AS (SELECT count(*) FILTER (WHERE life NOT IN ('water','ice'))::double precision AS gas,count(*) FILTER (WHERE life='water')::double precision AS water,count(*) FILTER (WHERE life='ice')::double precision AS ice,count(*)::double precision AS total FROM ideas), signals AS MATERIALIZED (SELECT COALESCE((SELECT 1-sum(count*count)/NULLIF(sum(count)*sum(count),0) FROM axes),0) AS diversity_index,LEAST(1,GREATEST(0,COALESCE((SELECT avg(strength) FROM edges),0))) AS resonance_density,COALESCE((SELECT count(*) FILTER (WHERE updated_at>=now()-interval '30 days')::double precision/NULLIF(count(*),0) FROM ideas),0) AS flow_rate,COALESCE(gas/NULLIF(total,0),0) AS gas,COALESCE(water/NULLIF(total,0),0) AS water,COALESCE(ice/NULLIF(total,0),0) AS ice,LEAST(1,COALESCE((SELECT count(*)::double precision FROM edges)/NULLIF((SELECT count(*) FROM nodes)*5.0,0),0)) AS connection_strength,LEAST(1,(SELECT count(*)::double precision/20.0 FROM nodes WHERE type='event' AND created_at>=now()-interval '7 days')) AS activity_pulse FROM phases), scored AS MATERIALIZED (SELECT signals.*,(-(CASE WHEN gas>0 THEN gas*ln(gas) ELSE 0 END+CASE WHEN water>0 THEN water*ln(water) ELSE 0 END+CASE WHEN ice>0 THEN ice*ln(ice) ELSE 0 END)/ln(3)) AS breath FROM signals), vitality AS (SELECT *,diversity_index*0.15+resonance_density*0.15+flow_rate*0.20+breath*0.15+connection_strength*0.15+activity_pulse*0.20 AS score FROM scored) SELECT jsonb_build_object('workspace_id',$1::text,'vitality_score',score,'signals',jsonb_build_object('diversity_index',diversity_index,'resonance_density',resonance_density,'flow_rate',flow_rate,'breath_rhythm',jsonb_build_object('gas',gas,'water',water,'ice',ice),'connection_strength',connection_strength,'activity_pulse',activity_pulse),'health_description',CASE WHEN score>=0.7 THEN 'Thriving — diverse contributors, flowing ideas, strong connections' WHEN score>=0.4 THEN 'Growing — active connections and room for new contributions' ELSE 'Germinating — ideas and invitations are taking root' END,'generated_at',now())::text FROM vitality";
  def gp-resonance() = "WITH recent AS (SELECT n.*,COALESCE(NULLIF(n.properties->>'last_activity_at','')::timestamptz,n.updated_at) AS active FROM graph_nodes n WHERE n.type='idea' AND " ++ gp-workspace() ++ "), page AS (SELECT jsonb_build_object('idea_id',id,'name',name,'last_activity_at',active,'free_energy_score',COALESCE(NULLIF(properties->>'free_energy_score','')::double precision,0),'manifestation_status',COALESCE(properties->>'manifestation_status','none'),'activity_type','graph-update') AS body,active,id FROM recent WHERE active>=now()-($2::double precision*interval '1 hour') ORDER BY active DESC,id LIMIT NULLIF($3::bigint,0) OFFSET $4::bigint) SELECT jsonb_build_object('items',COALESCE(jsonb_agg(body ORDER BY active DESC,id),'[]'::jsonb))::text FROM page";
  def gp-nodes() = "WITH filtered AS NOT MATERIALIZED (SELECT n.* FROM graph_nodes n WHERE " ++ gp-workspace() ++ " AND " ++ gp-visible(7) ++ " AND ($2::text='' OR type=$2) AND ($3::text='' OR phase=$3) AND ($4::text='' OR name ILIKE '%'||$4||'%' OR description ILIKE '%'||$4||'%')), selected AS MATERIALIZED (SELECT n.id,n.updated_at FROM filtered n ORDER BY n.updated_at DESC,n.id LIMIT NULLIF($5::bigint,0) OFFSET $6::bigint), page AS (SELECT " ++ gp-node() ++ " AS body,n.updated_at,n.id FROM selected p JOIN graph_nodes n ON n.id=p.id) SELECT jsonb_build_object('items',COALESCE((SELECT jsonb_agg(body ORDER BY updated_at DESC,id) FROM page),'[]'::jsonb),'total',(SELECT count(*) FROM filtered))::text";
  def gp-node-detail() = "SELECT (" ++ gp-node() ++ ")::text FROM graph_nodes n WHERE (n.id=$1 OR n.properties->>'slug'=$1) AND " ++ gp-visible(2) ++ " ORDER BY (n.id=$1) DESC LIMIT 1";
 }
}
