// endpoint_grocery_duplicate_groups.bml
//
// Source authority for the grocery duplicate-review policy.  A phone that
// re-posted one market run many times leaves a run of ledger entries with the
// same day, direction, amount and description, created within hours of each
// other.  This policy names those runs so the hub's manager can keep one entry
// and cancel the rest through the Sheet cancellation path.
//
// Carrier contract (api/app/routers/grocery.py, _duplicate_groups):
//   entries-wire  = "position|signature|created_seconds;..." ordered by
//                   (signature, created_seconds) ascending; signature is an
//                   opaque token the carrier assigns per distinct
//                   (spent_on, kind, amount_idr, description); created_seconds
//                   is the entry's creation instant as whole seconds.
//   window-seconds = how long after a group's FIRST entry a repeat still
//                   counts as the same run.
// Result: a list of groups, each the list of positions in wire order, only
// groups of two or more.  Position order inside a group is creation order, so
// the head of each group is the oldest entry — the natural one to keep.
//
// Lowered by the Form source compiler into endpoint_grocery_duplicate_groups.fk
// for the deployed fkwu runtime:
//   python3 scripts/lower_bml_recipe.py \
//     api/app/form_recipes/endpoint_grocery_duplicate_groups.bml \
//     '(let entries_wire "") (let window_seconds 43200) (grocery-duplicate-main entries_wire window_seconds)'
// The checked-in recipe is a deploy artifact; edit this source, regenerate,
// and prove it with api/tests/test_grocery_ledger.py.

section [form.bml] {
    class GroceryDuplicatePolicy {
        def gdp-reverse-onto(remaining, reversed) {
            if eq(len(remaining), 0) then reversed
            else gdp-reverse-onto(tail(remaining), cons(head(remaining), reversed));
        }
        def gdp-reverse(values) = gdp-reverse-onto(values, empty());

        def gdp-split-loop(value, separator, start, reversed) {
            let next = str_find(value, separator, start);
            if lt(next, 0) then
                gdp-reverse(cons(substring(value, start, str_len(value)), reversed))
            else
                gdp-split-loop(
                    value,
                    separator,
                    add(next, str_len(separator)),
                    cons(substring(value, start, next), reversed)
                );
        }
        def gdp-split(value, separator) = gdp-split-loop(value, separator, 0, empty());

        def gdp-decode-entry(wire) {
            let fields = gdp-split(wire, "|");
            list(str_to_int(nth(fields, 0)), nth(fields, 1), str_to_int(nth(fields, 2)));
        }
        def gdp-position(entry) = nth(entry, 0);
        def gdp-signature(entry) = nth(entry, 1);
        def gdp-created(entry) = nth(entry, 2);
        def gdp-nobody() = list(-1, "", 0);

        def gdp-same-run?(first, entry, window) {
            and(
                str_eq(gdp-signature(first), gdp-signature(entry)),
                le(sub(gdp-created(entry), gdp-created(first)), window)
            );
        }

        def gdp-close-run(current, groups) {
            if lt(len(current), 2) then groups
            else cons(gdp-reverse(current), groups);
        }

        def gdp-walk(wire, start, window, first, current, groups) {
            if ge(start, str_len(wire)) then gdp-reverse(gdp-close-run(current, groups))
            else gdp-walk-next(wire, start, window, first, current, groups, str_find(wire, ";", start));
        }
        def gdp-walk-next(wire, start, window, first, current, groups, next) {
            let stop = if lt(next, 0) then str_len(wire) else next;
            let next-start = if lt(next, 0) then str_len(wire) else add(next, 1);
            let entry = gdp-decode-entry(substring(wire, start, stop));
            if and(gt(len(current), 0), gdp-same-run?(first, entry, window)) then
                gdp-walk(wire, next-start, window, first, cons(gdp-position(entry), current), groups)
            else
                gdp-walk(
                    wire,
                    next-start,
                    window,
                    entry,
                    list(gdp-position(entry)),
                    gdp-close-run(current, groups)
                );
        }

        def grocery-duplicate-groups(entries-wire, window-seconds) {
            if eq(str_len(entries-wire), 0) then empty()
            else gdp-walk(entries-wire, 0, window-seconds, gdp-nobody(), empty(), empty());
        }
        def grocery-duplicate-main(entries-wire, window-seconds) {
            grocery-duplicate-groups(entries-wire, window-seconds);
        }
    }
}
