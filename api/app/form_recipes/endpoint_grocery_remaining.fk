(do
  (defn grocery-signed-total (values)
    (if (eq (len values) 0)
      0
      (add (head values) (grocery-signed-total (tail values)))))
  (defn grocery-remaining (sheet-available sheet-remaining pending-signed graph-signed)
    (if sheet-available
      (sub sheet-remaining (grocery-signed-total pending-signed))
      (sub 0 (grocery-signed-total graph-signed))))
  (let sheet_available false)
  (let sheet_remaining 0)
  (let pending_signed (list))
  (let graph_signed (list))
  (grocery-remaining sheet_available sheet_remaining pending_signed graph_signed))
