// Retire released service owners in the host's live Compose document.
// Compose supplies its JSON model without resolving environment values;
// Form edits that model, preserves a private backup and publishes atomically.
// stdin: {"host":"root@host","key":"/local/key","compose":"/host/docker-compose.yml","backup":"/host/private-backup.yml","stage":"/host/docker-compose.incoming.yml","activate":["web"]}
// preludes: form/form-stdlib/core.fk form/form-stdlib/json.fk form/form-stdlib/bml/stdin-source.bml form/form-stdlib/bml/host-child.bml
import remote_task.bml;
import native_http.bml;
section [form.bml] {
 class DeploymentComposeCare {
  def dcc-get(doc, key) = json-string-value(json-object-get(doc, key)) ?? "";
  def dcc-run(doc, step, args, input) {
   let argv = rmt-argv(doc,args);
   let io = "../.cache/private-compose-care-" ++ host_pid().str(); let made = hch-mkdirs(io); let private = host_chmod(io,448);
   private != 0 ? form_error("deployment compose care: private source trace was not admitted") : 0;
   let result = hch-run-at(io,step,host_cwd(),argv,input,hch-by(30000));
   (Comparable) result[0] == 0 ? result[1] : form_error("deployment compose care: " ++ step ++ " failed; retained private host-child trace");
  }
  def dcc-read(doc) = parse-json("deployment-compose", dcc-run(doc, "compose-model-read", ["docker", "compose", "-f", dcc-get(doc, "compose"), "config", "--format", "json", "--no-interpolate", "--no-env-resolution"], ""));
  def dcc-retired?(name,release) = any?(owner => owner == name,release);
  def dcc-set(doc, key, value) = json-node-object(append(filter(pair => json-pair-key(pair) != key, node_children(doc)), [json-node-pair(key, value)]));
  // Compose keeps KEY=value rows in --no-interpolate models and may return a
  // map elsewhere. Both presentations become the same editable label model.
  def dcc-label-pair(row) {
   let text = json-string-value(row);
   let at = str_find(text, "=", 0);
   at < 0 ? json-node-pair(text, json-node-string("")) : json-node-pair(substring(text, 0, at), json-node-string(substring(text, at + 1, len(text))));
  }
  def dcc-labels(labels) = node_eq(node_category(labels), JSON-ARRAY()) ? json-node-object(map(row => dcc-label-pair(row), node_children(labels))) : labels;
  // A service alias has one owner. Move every router reference before releasing
  // its duplicate port declaration; unrelated hosts and routes stay intact.
  def dcc-service-alias(labels, old, owner) = json-node-object(map(pair => {
   let key = json-pair-key(pair);
   let value = json-pair-value(pair);
   str_find(key, "traefik.http.routers.", 0) == 0 && json-string-value(value) == old ? json-node-pair(key, json-node-string(owner)) : pair;
  }, filter(pair => str_find(json-pair-key(pair), "traefik.http.services." ++ old ++ ".", 0) != 0, node_children(labels))));
  def dcc-web(service) {
   let labels = dcc-labels(json-object-get(service, "labels"));
   let moved = dcc-service-alias(labels, "coherence-web-hati", "coherence-web");
   let current = json-node-object(filter(pair => str_find(json-pair-key(pair), "traefik.http.routers.hati-web.", 0) != 0, node_children(moved)));
   dcc-set(service, "labels", dcc-set(current, "traefik.http.routers.coherence-web.service", json-node-string("coherence-web")));
  }
  def dcc-owners(body) = node_children(json-object-get(body, "services"));
  def dcc-object(doc) = node_eq(node_category(doc),JSON-OBJECT()) ? doc : json-node-object([]);
  def dcc-native-dependency(body,service) {
   let dependencies = dcc-object(json-object-get(service,"depends_on"));
   let native = json-node-object([json-node-pair("condition",json-node-string("service_healthy")),json-node-pair("required",json-node-bool(true))]);
   let depended = dcc-set(service,"depends_on",dcc-set(dependencies,"native-api",native));
   let settings = ncf-file("../api/config/native_api.json"); let routes = node_children(json-object-get(settings,"routes"));
   let literals = foldl((out,path) => append(out,nha-existing-literals(read_file(json-string-value(path)) ?? "",ncf-string(settings,"existing_route_prefix"))),[],node_children(json-object-get(settings,"existing_route_sources")));
   let existing = filter(path => !any?(route => ncf-string(route,"method") == "GET" && ncf-string(route,"path") == path,routes),literals);
   let labels = dcc-labels(json-object-get(service,"labels"));
   let ports = filter(pair => str_find(json-pair-key(pair),"traefik.http.services.",0) == 0 && str_find(json-pair-key(pair),".loadbalancer.server.port",0)>0,node_children(labels));
   let alias = nil?(ports) ? form_error("existing API route needs its service port owner") : split-on(substring(json-pair-key(ports[0]),len("traefik.http.services."),len(json-pair-key(ports[0]))),".")[0];
   let kept = json-node-object(filter(pair => str_find(json-pair-key(pair),"traefik.http.routers.existing-api-reads.",0) != 0,node_children(labels)));
   let bindings = nil?(existing) ? [] : [["traefik.http.routers.existing-api-reads.rule",dcc-api-rules(body) ++ " && Method(`GET`) && (" ++ hch-join(map(path => "Path(`" ++ path ++ "`)",existing)," || ") ++ ")"],["traefik.http.routers.existing-api-reads.priority","400"],["traefik.http.routers.existing-api-reads.entrypoints","websecure"],["traefik.http.routers.existing-api-reads.tls.certresolver","letsencrypt"],["traefik.http.routers.existing-api-reads.service",alias]];
   dcc-set(depended,"labels",foldl((out,row) => dcc-set(out,row[0],json-node-string(row[1])),kept,bindings));
  }
  def dcc-api-rules(body) {
   let api = json-object-get(json-object-get(body,"services"),"api"); let labels = dcc-labels(json-object-get(api,"labels"));
   let rules = map(pair => json-string-value(json-pair-value(pair)),filter(pair => str_find(json-pair-key(pair),"traefik.http.routers.",0) == 0 && str_find(json-pair-key(pair),"traefik.http.routers.existing-api-reads.",0) != 0 && substring(json-pair-key(pair),len(json-pair-key(pair)) - 5,len(json-pair-key(pair))) == ".rule" && str_find(json-string-value(json-pair-value(pair)),"Host(",0)>=0,node_children(labels)));
   nil?(rules) ? form_error("native API needs the current public API host owner") : "(" ++ hch-join(rules," || ") ++ ")";
  }
  def dcc-native-api(body) {
   let api = json-object-get(json-object-get(body,"services"),"api"); let configured = dcc-get(api,"image");
   let image = len(configured)>0 ? configured : dcc-get(body,"name") ++ "-api";
   let settings = ncf-file("../api/config/native_api.json"); let routes = node_children(json-object-get(settings,"routes"));
   let rule = dcc-api-rules(body) ++ " && (" ++ hch-join(map(route => nha-route-rule(route),routes)," || ") ++ ")";
   let labels = json-node-object(map(p => json-node-pair(p[0],json-node-string(p[1])),[["traefik.enable","true"],["traefik.http.routers.native-api.rule",rule],["traefik.http.routers.native-api.priority","300"],["traefik.http.routers.native-api.entrypoints","websecure"],["traefik.http.routers.native-api.tls.certresolver","letsencrypt"],["traefik.http.routers.native-api.service","native-api"],["traefik.http.services.native-api.loadbalancer.server.port",json-emit(json-object-get(settings,"port"))]]));
   let mount = json-node-object([json-node-pair("type",json-node-string("bind")),json-node-pair("source",json-node-string("/root/.coherence-network/config.json")),json-node-pair("target",json-node-string("/root/.coherence-network/config.json")),json-node-pair("read_only",json-node-bool(true)),json-node-pair("bind",json-node-object([json-node-pair("create_host_path",json-node-bool(false))]))]);
   let health = json-node-object([json-node-pair("test",json-node-array(map(v => json-node-string(v),["CMD","/app/form/fkwu","/app/app/form_recipes/native_api_health.bml"]))),json-node-pair("interval",json-node-string("60s")),json-node-pair("timeout",json-node-string("10s")),json-node-pair("start_period",json-node-string("120s")),json-node-pair("retries",json-node-int(3))]);
   let database = json-node-object([json-node-pair("condition",json-node-string("service_healthy")),json-node-pair("required",json-node-bool(true))]);
   json-node-object([json-node-pair("image",json-node-string(image)),json-node-pair("entrypoint",json-node-array([json-node-string("/app/form/fkwu")])),json-node-pair("command",json-node-array([json-node-string("/app/app/form_recipes/native_api.bml")])),json-node-pair("working_dir",json-node-string("/app/form")),json-node-pair("read_only",json-node-bool(true)),json-node-pair("tmpfs",json-node-array([json-node-string("/tmp")])),json-node-pair("shm_size",json-node-string("1gb")),json-node-pair("volumes",json-node-array([mount,json-node-object([json-node-pair("type",json-node-string("bind")),json-node-pair("source",json-node-string("/docker/coherence-network/repo/api/config/fkwu.conf")),json-node-pair("target",json-node-string("/app/form/fkwu.conf")),json-node-pair("read_only",json-node-bool(true)),json-node-pair("bind",json-node-object([json-node-pair("create_host_path",json-node-bool(false))]))])])),json-node-pair("depends_on",json-node-object([json-node-pair("postgres",database)])),json-node-pair("healthcheck",health),json-node-pair("restart",json-node-string("unless-stopped")),json-node-pair("labels",labels)]);
  }
  def dcc-web-rules(body) {
   let web = json-object-get(json-object-get(body,"services"),"web");
   let labels = dcc-labels(json-object-get(web,"labels"));
   let rules = map(pair => json-string-value(json-pair-value(pair)),filter(pair => {
    let key = json-pair-key(pair); let value = json-string-value(json-pair-value(pair)) ?? "";
    str_find(key,"traefik.http.routers.",0) == 0 && substring(key,len(key) - 5,len(key)) == ".rule" && str_find(value,"Host(",0)>=0;
   },node_children(labels)));
   nil?(rules) ? form_error("native Pulse routing needs the current web host rules") : "(" ++ hch-join(rules," || ") ++ ")";
  }
  // The Python compatibility host is heavy per request on this host; eight in flight at the edge keeps
  // bots from saturating its loop so /api/ping and the health probe keep answering (2026-10-26).
  def dcc-api(service) {
   let labels = dcc-labels(json-object-get(service,"labels"));
   let bounds = [["traefik.http.middlewares.api-inflight.inflightreq.amount","8"],["traefik.http.routers.coherence-api.middlewares","api-inflight"],["traefik.http.routers.existing-api-reads.middlewares","api-inflight"]];
   dcc-set(service,"labels",foldl((out,p) => dcc-set(out,p[0],json-node-string(p[1])),labels,bounds));
  }
  def dcc-pulse(service,web_rules) {
   let build = json-object-get(service,"build");
   let context = dcc-get(build,"context");
   let root = str_find(context,".git#",0) >= 0 ? split-on(context,":pulse")[0] : "/docker/coherence-network/repo";
   let current = dcc-set(dcc-set(build,"context",json-node-string(root)),"dockerfile",json-node-string("pulse/Dockerfile"));
   let args = json-node-object([json-node-pair("COHERENCE_SOURCE_SHA",json-node-string("${DEPLOYED_SHA}")),json-node-pair("COHERENCE_FORM_SHA",json-node-string("${COHERENCE_FORM_SHA}"))]);
   let native = dcc-set(service,"build",dcc-set(current,"args",args));
   // pulse/config.json owns application configuration; keep unrelated settings.
   let environment = dcc-labels(json-object-get(native,"environment"));
   let kept = json-node-object(filter(pair => str_find(json-pair-key(pair),"PULSE_",0) != 0,node_children(environment)));
   let labels = dcc-labels(json-object-get(native,"labels"));
   // Every request forks one native handler; a public hit on /pulse or /pulse/history computes for seconds. Two in flight at the edge keeps pulse's children from starving the API (2026-10-26).
   let routes = [["traefik.http.routers.pulse.service","pulse"],["traefik.http.routers.pulse-web.rule",web_rules ++ " && (Path(`/pulse`) || Path(`/pulse/`))"],["traefik.http.routers.pulse-web.priority","200"],["traefik.http.routers.pulse-web.entrypoints","websecure"],["traefik.http.routers.pulse-web.tls.certresolver","letsencrypt"],["traefik.http.routers.pulse-web.service","pulse"],["traefik.http.middlewares.pulse-inflight.inflightreq.amount","2"],["traefik.http.routers.pulse.middlewares","pulse-inflight"],["traefik.http.routers.pulse-web.middlewares","pulse-inflight"]];
   let owned = foldl((out,p) => dcc-set(out,p[0],json-node-string(p[1])),labels,routes);
   dcc-set(dcc-set(dcc-set(native,"environment",kept),"shm_size",json-node-string("1gb")),"labels",owned);
  }
  def dcc-active?(body,release) = any?(pair => dcc-retired?(json-pair-key(pair),release), dcc-owners(body));
  def dcc-dependencies(service,release) {
   !json-object-has?(service,"depends_on") ? service : {
    let dependencies = json-object-get(service,"depends_on");
    dcc-set(service,"depends_on",node_eq(node_category(dependencies),JSON-ARRAY()) ? json-node-array(filter(row => !dcc-retired?(json-string-value(row),release),node_children(dependencies))) : json-node-object(filter(pair => !dcc-retired?(json-pair-key(pair),release),node_children(dependencies))));
   };
  }
  def dcc-volume-sources(services) = foldl((out,pair) => append(out,map(mount => ncf-string(mount,"source"),filter(mount => ncf-string(mount,"type") == "volume",node_children(json-object-get(json-pair-value(pair),"volumes"))))),[],node_children(services));
  def dcc-body(body,release) {
   let web_rules = dcc-web-rules(body);
   let retained = map(pair => json-node-pair(json-pair-key(pair),dcc-dependencies(json-pair-value(pair),release)),filter(pair => !dcc-retired?(json-pair-key(pair),release) && json-pair-key(pair) != "native-api",dcc-owners(body)));
   let services = json-node-object(append(map(pair => json-pair-key(pair) == "web" ? json-node-pair("web", dcc-web(json-pair-value(pair))) : json-pair-key(pair) == "api" ? json-node-pair("api", dcc-api(json-pair-value(pair))) : json-pair-key(pair) == "pulse" ? json-node-pair("pulse", dcc-pulse(json-pair-value(pair),web_rules)) : json-pair-key(pair) == "api" ? json-node-pair("api",dcc-native-dependency(body,json-pair-value(pair))) : pair,retained),[json-node-pair("native-api",dcc-native-api(body))]));
   let used = dcc-volume-sources(services);
   json-node-object(map(pair => json-pair-key(pair) == "services" ? json-node-pair("services", services) : json-pair-key(pair) == "volumes" ? json-node-pair("volumes",json-node-object(filter(volume => any?(name => name == json-pair-key(volume),used),node_children(json-pair-value(pair))))) : pair,node_children(body)));
  }
  // Release only containers resolved from this project's exact service labels.
  // An explicitly requested unused volume is released only after no container
  // holds it and its own project label agrees; shared ownership stays visible.
  def dcc-release(doc,body,release) {
   let project = dcc-get(body,"name"); let volumes = record_new(0,"names",[]); let owners = record_new(0,"count",0);
   let stopped = map(service => {
    let source = dcc-run(doc,"release-owner-" ++ service,["docker","ps","-a","--no-trunc","--filter","label=com.docker.compose.project=" ++ project,"--filter","label=com.docker.compose.service=" ++ service,"--format","{{.ID}}"],"");
    map(id => {
     len(id) != 64 || !all?(i => str_find("0123456789abcdef",substring(id,i,i+1),0)>=0,range(0,len(id))) ? form_error("release owner returned no exact container identity") : {
      let mounts = parse-json("release-owner-mounts",dcc-run(doc,"release-mounts-" ++ id,["docker","inspect",id,"--format","{{json .Mounts}}"],""));
      let held = record_set(volumes,"names",append(record_get(volumes,"names"),map(mount => ncf-string(mount,"Name"),filter(mount => ncf-string(mount,"Type") == "volume",node_children(mounts)))));
      let removed = dcc-run(doc,"release-container-" ++ id,["docker","rm","--force",id],""); record_set(owners,"count",record_get(owners,"count")+1);
     };
    },filter(id => len(id)>0,split-on(trim(source),"\n")));
   },release);
   let names = foldl((out,name) => any?(prior => prior == name,out) ? out : append(out,[name]),[],record_get(volumes,"names"));
   let released = json-emit(json-object-get(doc,"release_unused_volumes")) != "true" ? [] : map(name => {
    let held = trim(dcc-run(doc,"volume-holders-" ++ name,["docker","ps","-a","--filter","volume=" ++ name,"--format","{{.ID}}"],""));
    let owner = trim(dcc-run(doc,"volume-owner-" ++ name,["docker","volume","inspect",name,"--format","{{index .Labels \"com.docker.compose.project\"}}"],""));
    let removed = len(held) == 0 && owner == project ? dcc-run(doc,"release-volume-" ++ name,["docker","volume","rm",name],"") : "";
    json-node-object([json-node-pair("volume",json-node-string(name)),json-node-pair("released",json-node-bool(len(removed)>0)),json-node-pair("care",json-node-string(len(held)>0 ? "An existing container still holds this volume" : owner != project ? "Volume belongs outside this project" : ""))]);
   },names);
   json-node-object([json-node-pair("containers_released",json-node-int(record_get(owners,"count"))),json-node-pair("volumes",json-node-array(released))]);
  }
  def dcc-apply(doc, body,release) {
   let backup = dcc-run(doc, "compose-source-backup", ["cp", "--no-clobber", dcc-get(doc, "compose"), dcc-get(doc, "backup")], "");
   let private-backup = dcc-run(doc, "compose-backup-private", ["chmod", "600", dcc-get(doc, "backup")], "");
   let staged = dcc-run(doc, "compose-source-stage", ["tee", dcc-get(doc, "stage")], json-emit(dcc-body(body,release)) ++ "\n");
   let yaml = dcc-run(doc, "compose-yaml-carrier", ["docker", "compose", "-f", dcc-get(doc, "stage"), "config", "--format", "yaml", "--no-interpolate", "--no-env-resolution"], "");
   let rendered = dcc-run(doc, "compose-yaml-stage", ["tee", dcc-get(doc, "stage")], yaml);
   let private-stage = dcc-run(doc, "compose-stage-private", ["chmod", "600", dcc-get(doc, "stage")], "");
   let accepted = dcc-run(doc, "compose-model-accept", ["docker", "compose", "-f", dcc-get(doc, "stage"), "config", "--quiet", "--no-interpolate", "--no-env-resolution"], "");
   let published = dcc-run(doc, "compose-source-publish", ["mv", dcc-get(doc, "stage"), dcc-get(doc, "compose")], "");
   let released = dcc-release(doc,body,release);
   let activated = dcc-activate(doc);
   dcc-active?(dcc-read(doc),release) ? form_error("deployment compose care: released service owner remains") : json-emit(ncf-merge(released,json-node-object([json-node-pair("status",json-node-string("applied")),json-node-pair("source_backup",json-node-bool(true)),json-node-pair("activated",json-object-get(doc,"activate"))])));
  }
  def dcc-activate(doc) {
   let owners = map(row => json-string-value(row), node_children(json-object-get(doc, "activate")));
   len(owners) == 0 ? "" : dcc-run(doc, "compose-owner-activate", append(["docker", "compose", "-f", dcc-get(doc, "compose"), "up", "-d", "--no-build", "--no-deps"], owners), "");
  }
  def dcc-care(doc) {
   let body = dcc-read(doc);
   let release = map(row => json-string-value(row),node_children(json-object-get(doc,"release")));
   dcc-get(doc,"mode") == "observe" ? dcc-plan(body,release) : dcc-apply(doc, body,release);
  }
  def dcc-plan(body,release) {
   let next = dcc-body(body,release); let services = json-object-get(next,"services"); let native = json-object-get(services,"native-api");
   json-emit(json-node-object([json-node-pair("idempotent",json-node-bool(node_eq(next,dcc-body(next,release)))),json-node-pair("release",json-node-array(map(json-node-string,release))),json-node-pair("existing_service",json-object-get(json-object-get(json-object-get(services,"api"),"labels"),"traefik.http.routers.existing-api-reads.service")),json-node-pair("image",json-object-get(native,"image")),json-node-pair("native_command",json-object-get(native,"command")),json-node-pair("public_routes",json-object-get(json-object-get(native,"labels"),"traefik.http.routers.native-api.rule")),json-node-pair("api_dependencies",json-object-get(json-object-get(services,"api"),"depends_on"))]));
  }
 }
 let doc = parse-json("deployment-compose-care", stdin-text());
 dcc-care(doc);
}
