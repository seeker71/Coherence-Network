// Preserve the pulse history, then retire the two observed stale proof silences.
// The bounded health surface does not observe schema/audit proof; retirement
// records that fact and never manufactures a successful proof sample.
// stdin: {"host":"root@host","key":"/local/key","db":"/host/pulse.db","backup":"/host/private-backup.db"}
// preludes: form/form-stdlib/core.fk form/form-stdlib/json.fk form/form-stdlib/bml/stdin-source.bml form/form-stdlib/bml/host-child.bml
section [form.bml] {
 class PulseProofCare {
  def ppc-get(doc, key) = json-string-value(json-object-get(doc, key)) ?? "";
  def ppc-run(doc, step, input) {
   let argv = ["ssh", "-i", ppc-get(doc, "key"), "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", ppc-get(doc, "host"), "sqlite3", "-bail", ppc-get(doc, "db")];
   let result = hch-run(step, argv, input, hch-by(60000));
   (Comparable) result[0] == 0 ? result[1] : form_error("pulse proof care: " ++ step ++ " failed; retained host-child trace");
  }
  def ppc-apply(doc, target, read, before) {
    let backup = ppc-run(doc, "pulse-proof-backup", ".timeout 5000\n.backup " ++ ppc-get(doc, "backup") ++ "\n");
    let archived = ppc-run(doc, "pulse-proof-retire", ".timeout 5000\nBEGIN IMMEDIATE;\nUPDATE silences SET ended_at=strftime('%Y-%m-%dT%H:%M:%SZ','now'), note='Proof probe retired: bounded health does not observe this claim; no successful proof inferred. Continue on changed source or finding.' WHERE " ++ target ++ ";\nSELECT changes();\nCOMMIT;\n");
    let after = ppc-run(doc, "pulse-proof-read-after", read);
    len(after) == 0 ? ["Proof silences retired; history and private backup retained; no success proof inferred.", before, archived] : form_error("pulse proof care: observed silence remains open");
  }
  def ppc-care(doc) {
   let target = "id IN (33302,33303) AND organ IN ('schema','audit_integrity') AND ended_at IS NULL";
   let read = "SELECT id,organ FROM silences WHERE " ++ target ++ ";\n";
   let before = ppc-run(doc, "pulse-proof-read", read);
   len(before) == 0 ? "The observed proof silences are already retired; history retained." : ppc-apply(doc, target, read, before);
  }
 }
 let doc = parse-json("pulse-proof-care", stdin-text());
 ppc-care(doc);
}
