#!/usr/bin/env bash
# Thin local door to the Form-built native CLI. The image replaces this file
# with that binary directly; source checkouts build/select it through the gate.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
root="$(cd -P "$(dirname "$src")/.." && pwd)"
native="$(bash "$root/scripts/ensure_form_cli_native.sh" --print-path)"
# The native carrier speaks a line protocol on stdin (`ask <question>`, `grounded <question>`, `help`, …);
# words on the command line are one such line, and with none the caller's stdin is the conversation.
if [ "$#" -gt 0 ]; then
  exec "$native" < <(printf '%s\n' "$*")
fi
exec "$native"
