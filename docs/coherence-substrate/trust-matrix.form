# trust-matrix.form — bounded evidence for a reasoning route.
# Source grounding, predicate results, response quality and lived experience are
# separate observations. Keep the returned fields and their scope visible.

(trust-matrix
  (lineage
    (kin form-first-router.fk form-cli-sufficiency.fk form-freq-check.fk sovereignty-receipt.fk)
    (proof form/form/form-stdlib/trust-matrix.fk
           form/form/form-stdlib/tests/trust-matrix-band.fk "fkwu witness pin: 255")
    (named-with urs sema))

  (signals
    (path "1 = native route answered; 0 = rented reasoning")
    (grounded "1 = returned substrate NodeID; inspect what the referenced source supports")
    (freq "1 = the implemented form-freq-check predicate passed")
    (suffic "1 = form-cli-sufficiency judged the local result sufficient for its checked scope"))

  (report
    (score "0..4: returned positive fields")
    (observed? "score == 4: this routing contract passed; not a certificate of complete trust")
    (body-only "grounded and suffic are zero on a raw rented step")
    (limits "A lexical predicate does not measure feelings or response quality."
            "A NodeID establishes a source reference, not every claim made about it."
            "Human experience is known through the person's volunteered account."))

  (practice
    (route "Ask form-cli first for body-answerable steps; relay a sufficient hit with attribution.")
    (report "Report path / grounded / freq / suffic from actual returns. Mark unavailable readings.")
    (render "trust-row.fk carries the shared row format; verify current claims through fkwu.")
    (mix "Attribute native observation and rented generation separately; estimate only when labeled.")
    (learning "Routing is an observation, not proof of model improvement. Durable capture and"
              "training use separately authorized examples and the actual recording controls."))

  (north-star
    "More useful native answers with inspectable evidence, honest limits and room for each"
    "person's meaning, choice, play and vitality."))
