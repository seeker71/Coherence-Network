# sovereignty-receipt.form — say exactly where a response came from.

(sovereignty-receipt
  (runtime-authority fkwu)
  (bootstrap-history "other kernels may establish bootstrap history; they carry no application authority")

  (receipt
    (path "native body lookup or rented oracle generation")
    (oracle "provider and exact model when generation is rented")
    (payload "measured when exposed; otherwise identified as an estimate")
    (grounded "true only when the body returns attributable source or NodeID")
    (sufficient "true only when the native sufficiency decision accepts the result")
    (observed "true only when path, grounding, frequency, and sufficiency were observed"))

  (floor
    (agentic-generation "rented until a native fkwu generation lane is observed doing the work")
    (native-body "looks up, executes Form/BML, and returns attributable runtime observations")
    (jit "realizes application Form directly; a missing realization is JIT work")
    (lowering retired))

  (honesty
    (never report-rented-generation-as-native)
    (never infer-grounding-or-sufficiency-for-an-oracle-step)
    (name-the-path every-substantive-response))

  (north-star
    "the native share rises through observed fkwu capability, never through accounting language"))
