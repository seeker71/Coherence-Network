# spec-registry-router.form -- the current spec registry route family
#
# fkwu is the sole kernel. The BML read catalog is implemented source waiting
# for native HTTP/config/persistence/startup ownership. FastAPI remains the
# compatibility host for public transport and all mutation effects.

form spec_route_shape = {
    name: ~String,
    method: ~String,
    path: ~String,
    native_handler: ~String,
    live_carrier: ~String,
    state: ~String,
};

form spec_route_recipe_shape = {
    family: ~String,
    routes: [spec_route_shape],
    authority: ~String,
    next_work: ~String,
};

defn spec_route(name, method, path, native_handler, state) =
    spec_route_shape {
        name: name,
        method: method,
        path: path,
        native_handler: native_handler,
        live_carrier: "api/app/routers/spec_registry.py",
        state: state,
    };

defn browse_specs_recipe() = spec_route_recipe_shape {
    family: "browse",
    routes: [
        spec_route("list", "GET", "/api/spec-registry", "api_spec_registry", "BML handler implemented; compatibility HTTP live"),
        spec_route("detail", "GET", "/api/spec-registry/{spec_id}", "api_spec_registry_detail", "BML handler implemented; template dispatch remains native-host work"),
        spec_route("idea-specs", "GET", "/api/ideas/{idea_id}/specs", "api_idea_specs", "BML handler implemented; template dispatch remains native-host work"),
    ],
    authority: "form/form/apps/coherence-network/api.bml",
    next_work: "move HTTP dispatch, file configuration, and Postgres ownership into the fkwu host",
};

defn mutate_specs_recipe() = spec_route_recipe_shape {
    family: "mutate",
    routes: [],
    authority: "api/app/routers/spec_registry.py",
    next_work: "author create/update/delete in BML, move persistence effects, then release the Python owners",
};

defn spec_registry_router_structure() = {
    runtime: "fkwu",
    native_catalog: "form/form/apps/coherence-network/api.bml",
    live_http_host: "api/app/routers/spec_registry.py",
    native_routes: [browse_specs_recipe()],
    retired: ["sibling kernel router", "native preview headers", "Python fallback fanout", "host harnesses"],
    current_gap: "native template dispatch, mutation recipes, configuration, Postgres, persistence, and startup ownership",
};

defn spec_registry_router_reading() = {
    observed: [
        "fkwu is the only kernel runtime",
        "the BML catalog implements graph-backed list, detail, and per-idea reads",
        "FastAPI still carries public transport, mutation, and persistence effects",
    ],
    measured: [
        "form/form/apps/coherence-network/api.bml",
        "api/app/routers/spec_registry.py",
        "docs/system_audit/form_kernel_floor_2026-10-18.md",
    ],
    direction: "move one complete route family at a time, then remove its Python owner",
};
