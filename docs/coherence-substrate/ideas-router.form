# ideas-router.form -- the current ideas route family
#
# fkwu is the sole kernel. The BML catalog below is implemented source waiting
# for native HTTP/config/persistence/startup ownership; FastAPI remains the
# compatibility HTTP host until that boundary moves end to end.

form idea_route_shape = {
    name: ~String,
    method: ~String,
    path: ~String,
    native_handler: ~String,
    live_carrier: ~String,
    state: ~String,
};

form idea_route_recipe_shape = {
    family: ~String,
    routes: [idea_route_shape],
    authority: ~String,
    next_work: ~String,
};

defn idea_route(name, method, path, native_handler, state) =
    idea_route_shape {
        name: name,
        method: method,
        path: path,
        native_handler: native_handler,
        live_carrier: "api/app/routers/ideas.py",
        state: state,
    };

defn browse_ideas_recipe() = idea_route_recipe_shape {
    family: "browse",
    routes: [
        idea_route("list", "GET", "/api/ideas", "api_ideas", "BML handler implemented; compatibility HTTP live"),
        idea_route("detail", "GET", "/api/ideas/{idea_id}", "api_idea_detail", "BML handler implemented; template dispatch remains native-host work"),
        idea_route("resonance", "GET", "/api/ideas/resonance", "api_ideas_resonance", "BML handler implemented; compatibility HTTP live"),
    ],
    authority: "form/form/apps/coherence-network/api.bml",
    next_work: "move HTTP dispatch, file configuration, and Postgres ownership into the fkwu host",
};

defn sense_governance_recipe() = idea_route_recipe_shape {
    family: "sense",
    routes: [],
    authority: "api/app/routers/ideas.py",
    next_work: "author each remaining sensing route in BML before moving its effects",
};

defn choose_next_idea_recipe() = idea_route_recipe_shape {
    family: "choose",
    routes: [],
    authority: "api/app/routers/ideas.py",
    next_work: "move selection semantics as one Form recipe with observed persistence effects",
};

defn mutate_idea_recipe() = idea_route_recipe_shape {
    family: "mutate",
    routes: [
        idea_route("update", "PATCH", "/api/ideas/{idea_id}", "api_idea_update", "BML handler implemented; compatibility HTTP live"),
    ],
    authority: "form/form/apps/coherence-network/api.bml",
    next_work: "complete native create/delete and move mutation persistence into the fkwu host",
};

defn question_answer_recipe() = idea_route_recipe_shape {
    family: "question-answer",
    routes: [
        idea_route("question-create", "POST", "/api/ideas/{idea_id}/questions", "api_idea_question_create", "BML handler implemented; compatibility HTTP live"),
        idea_route("question-answer", "POST", "/api/ideas/{idea_id}/questions/answer", "api_idea_question_answer", "BML handler implemented; compatibility HTTP live"),
    ],
    authority: "form/form/apps/coherence-network/api.bml",
    next_work: "move template dispatch and persistence into the fkwu host",
};

defn link_idea_recipe() = idea_route_recipe_shape { family: "link", routes: [], authority: "api/app/routers/ideas.py", next_work: "BML route and effect ownership" };
defn translate_idea_recipe() = idea_route_recipe_shape { family: "translate", routes: [], authority: "api/app/routers/ideas.py", next_work: "BML route and effect ownership" };
defn invest_in_idea_recipe() = idea_route_recipe_shape { family: "invest", routes: [], authority: "api/app/routers/ideas.py", next_work: "BML route and effect ownership" };
defn rollup_super_idea_recipe() = idea_route_recipe_shape { family: "rollup", routes: [], authority: "api/app/routers/ideas.py", next_work: "BML route and effect ownership" };
defn inspect_idea_recipe() = idea_route_recipe_shape { family: "inspect", routes: [], authority: "api/app/routers/ideas.py", next_work: "BML route and effect ownership" };

defn ideas_router_structure() = {
    runtime: "fkwu",
    native_catalog: "form/form/apps/coherence-network/api.bml",
    live_http_host: "api/app/routers/ideas.py",
    native_routes: [browse_ideas_recipe(), mutate_idea_recipe(), question_answer_recipe()],
    retired: ["sibling kernel router", "native preview headers", "Python fallback fanout", "host harnesses"],
    current_gap: "native template dispatch, configuration, Postgres, persistence, and startup ownership",
};

defn ideas_router_reading() = {
    observed: [
        "fkwu is the only kernel runtime",
        "the BML catalog implements selected read and mutation handlers",
        "FastAPI still carries the public HTTP and persistence boundary",
    ],
    measured: [
        "form/form/apps/coherence-network/api.bml",
        "api/app/routers/ideas.py",
        "docs/system_audit/form_kernel_floor_2026-10-18.md",
    ],
    direction: "move one complete route family at a time, then remove its Python owner",
};
