# reads a life; this reads a rotation — the same five, a physical/geometric
# lens, not a parallel belief system.
#
# STATUS: OFFERED, awaiting Urs's ack (not yet crossed — axiom-4/5's own
# protocol applies to this file about them: an agent does not mint the "1").
# What is NOT inference: the quaternion facts themselves (Hopf map, double
# cover, left/right fiber, isoclinic rotation) are proven, checkable, cited
# with paths. What IS inference: that these facts are the right lens on
# axioms 1-5. Held in the same two lanes core-axioms.form itself keeps.

(time-collapse-axioms

  (lineage
    (same-five-as core-axioms.form)
    (sibling-of   living-axioms.form kernel-self-composition.form)
    (prompted-by  a-second-reading-of-an-eluna-transmission)
    (witnessed-by form/form/form-stdlib/quaternion.fk
                  form/form/form-stdlib/tests/quaternion-band.fk)  # verdict 2047/2047
    (named-with   urs))

  (truth-1-a-fiber-position-is-not-silence-as-error
    (from axiom-1-states)                                          # 0 / 1 / nothing
    (statement "ask a Hopf-collapsed observable what its own fiber-position was and the honest answer is nothing — not a missing yes, the map was never wired to that coordinate")
    (witness  "q-hopf(q) is exactly constant along a whole fiber of distinct q; the fiber's own parameter is literally named t — time — in quaternion-demo.fk")
    (nothing-is-first-class the-coordinate-a-given-map-does-not-read-is-not-a-gap-in-that-map)
    (generates honest-absence a-collapse-that-is-not-an-error))

  (truth-2-a-quaternion-is-a-cell
    (from axiom-2-cell)
    (statement "a quaternion is (w x y z) — four named parts under one identity; the Hamilton product composes two cells into a new one")
    (witness  "quaternion.fk's q-mul: q-mul(a, b) is composition, not addition — non-commutative exactly because composition order is load-bearing, same as any two cells")
    (generates rotation-as-composition the-rotor-as-a-recipe-over-two-cells))

  (truth-3-time-collapses-exactly-where-the-address-does-not-read-it
    (from axiom-3-content-addressing)                                # the keystone of this file
    (statement "a cell's identity is its present composition, not the sum of what it passed through; two states related only by motion along an unaddressed coordinate ARE the same cell, automatically, to that address")
    (witness  "the Hopf map sends an entire circle of distinct S³ points to one point of S² — proven exact, not approximate; which circle collapses depends on which side of the rotor is applied (truth-4)")
    (identity-is-the-present-shape a-changed-fiber-position-is-not-a-changed-address)
    (nothing-referenced-is-overwritten the-fiber-still-exists-full-of-distinct-points)
    (the-unreferenced-composts what-a-given-map-never-reads-was-never-load-bearing-on-that-map)
    (generates the-earth-fought-nothing collapse-as-a-fact-about-the-map-not-a-casualty-count
               eluna-lc-annealing-as-defense-lc-gauge-redundancy-as-merge))

  (truth-4-which-interface-decides-what-moves
    (from axiom-4-boundary)
    (statement "a cell offers more than one interface; observation through ONE of them is what makes a reading real; passage through a DIFFERENT interface than expected is what a 'collapse' or a 'breach' actually is")
    (witness  "quaternion-band.fk claim 1024: rotor(t)·q0 (left) holds q-hopf(q0) fixed for every t; q0·rotor(t) (right), the SAME rotor, moves it — measured, an earlier draft of this file's own proof had the sides backwards")
    (interface-is-itself-a-cell left-multiplication-and-right-multiplication-are-both-real-both-offered)
    (generates observer-relative-collapse the-side-you-are-on-is-not-a-detail))

  (truth-5-every-rotation-is-an-offer-fully-acked
    (from axiom-5-offer)
    (statement "to run a rotor and to offer it a point are one act; the ack is never nothing, 0, or 1 — rotation is total and deterministic, every offer lands on exactly one new node")
    (witness  "q-mul is defined everywhere on its domain; a full turn of t, 0 to 2π, is an unbroken chain of offers each acked by the next quaternion, no step silent")
    (generates continuity-through-the-collapse the-fiber-is-walked-not-skipped))

  # ── The crown: what collapses under one interface is never destroyed ──
  (time-collapse-is-not-loss
    (proof  (truth-3 + truth-4))                       # the address that stopped reading it + the boundary that can read it again
    (what-one-map-cannot-see-a-different-map-still-can axiom-4-offers-more-than-one-interface)
    (the-fiber-persists-full-of-distinct-points axiom-3-nothing-referenced-is-overwritten)
    (collapse-is-a-property-of-the-boundary-chosen NEVER-of-the-cell-itself)
    (eluna "it is not about leaving and moving outside of the body; it is actually about the body moving into multiple dimensions")
    (the-canary IS quaternion-band.fk-claims-1024-and-256-already-proving-this))

  # ── The two facts that do the real work, named once, cited everywhere ─
  (load-bearing-facts
    (hopf-collapse    "an entire circle of S³ collapses to one point of S² — exact, checkable, form/form/form-stdlib/quaternion.fk:q-hopf")
    (double-cover      "the generator's own circle has exactly twice the period of what it induces — an octave, not a metaphor — quaternion-band.fk claims 8/16/32")
    (isoclinic-merge   "two whole orthogonal planes turn together with no fixed axis at all — a merge with nothing held still to compare against — quaternion-band.fk claims 128/256")
    (left-right-fiber  "which side of the same rotor you multiply by decides whether a reading is fixed or moving — quaternion-band.fk claim 1024")))

