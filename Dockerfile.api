# syntax=docker/dockerfile:1.6
#
# Coherence Network API image.
#
# The builder emits the c-bootstrap fkwu, the only production recipe runtime.
# Sibling kernels are bootstrap history only; none enters this image as a
# runtime, fallback, or routine validation target.
#
# This Dockerfile lives in the repo so the build context the deploy script
# uses (the repo root, cloned onto the VPS at /docker/coherence-network/repo)
# carries everything the build needs. The VPS docker-compose.yml references
# this file via `build: { context: ./repo, dockerfile: Dockerfile.api }`.

# -----------------------------------------------------------------------------
# Stage 1 — build the pinned c-bootstrap fkwu and native form-cli
# -----------------------------------------------------------------------------
ARG COHERENCE_SOURCE_SHA
ARG COHERENCE_FORM_SHA

FROM docker.io/library/gcc:12.5.0-bookworm@sha256:4adc71d718fb96aeda49f1da3a936e1ea07af2b192493414a8bca1c73b9f2adb AS kernel-builder

ARG COHERENCE_SOURCE_SHA
ARG COHERENCE_FORM_SHA

WORKDIR /build

# The compiler and libc arrive in this content-addressed builder image. The
# independent observer reads this exact pin from the release Dockerfile, so no
# later package-index movement can change either native build.
RUN printf '%s\n%s\n' "$COHERENCE_SOURCE_SHA" "$COHERENCE_FORM_SHA" \
      | grep -Eq '^[0-9a-f]{40}$' \
 && test "$(printf '%s\n%s\n' "$COHERENCE_SOURCE_SHA" "$COHERENCE_FORM_SHA" \
      | grep -Ec '^[0-9a-f]{40}$')" = 2 \
 && command -v cc >/dev/null \
 && command -v openssl >/dev/null

# Build the one runtime and ask door from the pinned fkwu/Form source. The
# Form-owned build gate replaces the deleted host build scripts.
COPY form/ /build/form/
# fkwu's shared cell/program arenas need the host's tmpfs capacity. Docker's
# default 64 MiB /dev/shm faults during native BML compilation (SIGBUS).
RUN --mount=type=tmpfs,target=/dev/shm cd /build/form \
 && SOURCE_DATE_EPOCH=0 LC_ALL=C TZ=UTC cc -O2 -o fkwu runtime/fkwu-uni.c \
 && printf '{"out":"/build/form-cli","force_link":1,"cc":"cc"}\n' \
      | ./fkwu gate/form-cli-build-run.bml \
 && sha256sum /build/form-cli | cut -d' ' -f1 > /build/form-cli.sha256 \
 && test -x /build/form-cli

# -----------------------------------------------------------------------------
# Stage 2 — Python runtime
# -----------------------------------------------------------------------------
FROM python:3.11-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba AS runtime

ARG COHERENCE_SOURCE_SHA
ARG COHERENCE_FORM_SHA

RUN printf '%s\n%s\n' "$COHERENCE_SOURCE_SHA" "$COHERENCE_FORM_SHA" \
      | grep -Eq '^[0-9a-f]{40}$' \
 && test "$(printf '%s\n%s\n' "$COHERENCE_SOURCE_SHA" "$COHERENCE_FORM_SHA" \
      | grep -Ec '^[0-9a-f]{40}$')" = 2

LABEL org.opencontainers.image.title="coherence-network-api"
LABEL org.opencontainers.image.description="Coherence Network API — FastAPI membrane with c-bootstrapped fkwu recipe execution"
LABEL org.opencontainers.image.source="https://github.com/seeker71/Coherence-Network"
LABEL org.opencontainers.image.revision="${COHERENCE_SOURCE_SHA}"
LABEL org.opencontainers.image.coherence-form-revision="${COHERENCE_FORM_SHA}"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# OS deps for PostgreSQL drivers, neo4j, healthchecks, and shell utilities.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      curl \
      ca-certificates \
      libpq5 \
      procps \
 && rm -rf /var/lib/apt/lists/*

# Python deps first for layer caching.
COPY api/requirements.txt ./requirements.txt
RUN python -m pip install --upgrade pip \
 && python -m pip install -r requirements.txt

# Copy only the two production carriers.
COPY --from=kernel-builder /build/form/fkwu /app/form/fkwu
COPY --from=kernel-builder /build/form-cli /app/form/form-cli
COPY --from=kernel-builder /build/form-cli.fkb /app/form/form-cli.fkb
COPY --from=kernel-builder /build/form-cli.sym /app/form/form-cli.sym
COPY --from=kernel-builder /build/form-cli.native.attestation /app/form/form-cli.native.attestation
COPY --from=kernel-builder /build/form-cli.source.id /app/form/form-cli.source.id
COPY --from=kernel-builder /build/form-cli.sha256 /app/form/form-cli.sha256
COPY form/runtime /app/form/runtime
COPY --from=kernel-builder /build/form/form/form-stdlib/ /app/form/form-stdlib/
RUN mkdir -p /app/bin \
 && ln /app/form/form-cli /app/bin/form-cli \
 && ln /app/form/form-cli.fkb /app/bin/form-cli.fkb \
 && ln /app/form/form-cli.sym /app/bin/form-cli.sym \
 && ln /app/form/form-cli.native.attestation /app/bin/form-cli.native.attestation \
 && ln /app/form/form-cli.source.id /app/bin/form-cli.source.id \
 && ln /app/form/form-cli.sha256 /app/bin/form-cli.sha256 \
 && chmod +x /app/form/fkwu /app/form/form-cli

# API source. The api/ dir is the package root inside the container; the
# Procfile uses `app.main:app` so /app needs to BE the api directory contents.
COPY api/ ./

# Scripts live at /app/scripts because auto-deploy.sh ALSO copies them in
# post-build (substrate ingest). Ship them at build time too so the image
# is self-contained for local docker runs.
COPY scripts/ ./scripts/
RUN test "$(sha256sum ./bin/form-cli | cut -d' ' -f1)" = "$(cat ./bin/form-cli.sha256)"

# Frontmatter source surfaces (specs, ideas, vision-kb). The deploy script
# re-syncs these on each deploy, but baking them in lets the image boot
# substrate-complete from a cold start.
COPY specs/ ./specs/
COPY ideas/ ./ideas/
COPY docs/ ./docs/

# Production runs this image with a read-only root filesystem and overlays
# four narrow writable grounding-state bind mounts. Docker cannot create a
# missing bind target inside a read-only rootfs during container startup, so
# keep the mountpoints in the immutable image itself.
RUN install -d -m 0700 \
      /root/.coherence-network/rag-index \
      /root/.coherence-network/rag-requests \
      /root/.coherence-network/attestation \
      /root/.coherence-network/api-queries \
      /root/.coherence-network/federation-graph

EXPOSE 8000

# Docker liveness must stay independent of deep health/audit work. The full
# /api/health contract remains a release proof, while /api/ping answers only
# from the event loop and keeps Traefik from withdrawing a living API during
# cold-cache or substrate maintenance.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/ping || exit 1

CMD ["python", "-m", "app.server"]
